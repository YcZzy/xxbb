page {
  animation: page-soft-enter 0.18s cubic-bezier(0.22, 0.74, 0.28, 1) both;
  background: #fff7ed;
  color: #2a2220;
  font-family:
    -apple-system,
    BlinkMacSystemFont,
    PingFang SC,
    Microsoft YaHei,
    sans-serif;
  min-height: 100%;
}

button {
  background: transparent;
  border: 0;
  box-sizing: border-box;
  line-height: 1;
  margin: 0;
  padding: 0;
}

button::after {
  display: none;
}

.safe-bottom-space {
  height: calc(150rpx + env(safe-area-inset-bottom));
}

@-webkit-keyframes page-soft-enter {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes page-soft-enter {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.performance-lite button,
.performance-lite image,
.performance-lite text,
.performance-lite view {
  animation-duration: 1ms !important;
  animation-iteration-count: 1 !important;
  transition-duration: 0.12s !important;
}
