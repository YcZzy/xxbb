.help-page.personal-center {
  --help-ink: #352a30;
  --help-muted: #9a858d;
  --help-line: #f1e8eb;
  --help-band: #fff3ee;
  --help-tint: #fbf4f3;
  --help-accent: #ca4859;
  background: #fffefd;
  box-sizing: border-box;
  color: var(--help-ink);
  letter-spacing: 0;
  min-height: 100vh;
  padding: 0;
}

.personal-center.theme-siwuliu-ice {
  --help-ink: #294753;
  --help-muted: #708c97;
  --help-line: #dbeaf0;
  --help-band: #f0f9fc;
  --help-tint: #e6f2f7;
  --help-accent: #357f9e;
}

.personal-center.theme-xiaoyu-moon-tide {
  --help-ink: #294e51;
  --help-muted: #6e8b8b;
  --help-line: #d6e9e5;
  --help-band: #eef9f7;
  --help-tint: #e1f1ed;
  --help-accent: #278694;
}

.personal-center .personal-tools {
  background: #fffefd;
  padding: 26rpx 34rpx 24rpx;
}

.personal-section-title {
  align-items: center;
  color: var(--help-ink);
  display: flex;
  font-size: 29rpx;
  font-weight: 750;
  gap: 16rpx;
  line-height: 1.5;
}

.personal-section-title::after {
  background: linear-gradient(90deg, #ddb6a2, transparent);
  content: '';
  height: 2rpx;
  width: 68rpx;
}

.personal-tool-grid {
  display: grid;
  gap: 12rpx;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 22rpx;
}

.personal-center .personal-tool {
  --tool-tone: #588c77;
  --tool-soft: #edf8f3;
  align-items: center;
  animation: service-arrive 0.5s ease-out backwards;
  border: 1rpx solid #ede5e2;
  border-radius: 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  font-size: 23rpx;
  font-weight: 600;
  gap: 12rpx;
  height: 142rpx;
  justify-content: center;
  line-height: 1.5;
  margin: 0;
  min-width: 0;
  padding: 10rpx 0;
  position: relative;
  transition:
    box-shadow 0.2s,
    -webkit-transform 0.2s cubic-bezier(0.2, 0.9, 0.3, 1.4);
  transition:
    transform 0.2s cubic-bezier(0.2, 0.9, 0.3, 1.4),
    box-shadow 0.2s;
  transition:
    transform 0.2s cubic-bezier(0.2, 0.9, 0.3, 1.4),
    box-shadow 0.2s,
    -webkit-transform 0.2s cubic-bezier(0.2, 0.9, 0.3, 1.4);
}

.personal-tool[data-tone='amber'] {
  --tool-tone: #bc8750;
  --tool-soft: #fff6e8;
  animation-delay: 45ms;
}

.personal-tool[data-tone='aqua'] {
  --tool-tone: #479689;
  --tool-soft: #ecf8f6;
  animation-delay: 90ms;
}

.personal-tool[data-tone='rose'] {
  --tool-tone: #b87982;
  --tool-soft: #fcf0f0;
  animation-delay: 135ms;
}

.personal-tool::before {
  background: var(--tool-tone);
  border-radius: 3rpx;
  bottom: 0;
  content: '';
  height: 3rpx;
  left: 27%;
  opacity: 0.65;
  position: absolute;
  right: 27%;
  transition:
    left 0.2s,
    right 0.2s;
}

.personal-tool::after {
  border: 0;
}

.personal-center .personal-tool-grid .personal-tool {
  background: linear-gradient(155deg, #fff, var(--tool-soft)) !important;
  border-color: #ede5e2 !important;
  box-shadow:
    0 5rpx 0 #eee6e1,
    0 8rpx 14rpx #4d29310a,
    inset 0 0 0 2rpx #fff !important;
  color: var(--help-ink) !important;
}

.personal-center .personal-tool-grid .personal-tool--pressed,
.personal-center .personal-tool-grid .personal-tool:active {
  box-shadow:
    0 1rpx 0 #eee6e1,
    inset 0 2rpx 4rpx #4d29310c !important;
  transform: translateY(4rpx) scale(0.96);
}

.personal-tool--pressed::before {
  left: 16%;
  right: 16%;
}

.personal-tool[disabled] {
  opacity: 0.55;
}

.personal-tool-icon {
  align-items: center;
  border-radius: 16rpx;
  display: flex;
  height: 76rpx;
  justify-content: center;
  transition: transform 0.28s cubic-bezier(0.2, 0.9, 0.3, 1.4);
  transition:
    transform 0.28s cubic-bezier(0.2, 0.9, 0.3, 1.4),
    -webkit-transform 0.28s cubic-bezier(0.2, 0.9, 0.3, 1.4);
  width: 76rpx;
}

.personal-tool-icon .original-tool-image {
  height: 82rpx;
  width: 82rpx;
}

.personal-tool-icon .repair-icon-orbit,
.personal-tool-icon .test-bell,
.personal-tool-icon .test-icon-ring {
  animation: none;
}

.personal-tool--pressed .personal-tool-icon,
.personal-tool:active .personal-tool-icon {
  transform: translateY(-6rpx) rotate(-8deg) scale(1.08);
}

.personal-tool--pressed .test-bell {
  animation: test-bell-rock 0.5s ease-in-out;
}

.personal-tool--pressed .repair-icon-orbit {
  animation: repair-orbit 0.6s ease-in-out;
}

.personal-center .personal-faq {
