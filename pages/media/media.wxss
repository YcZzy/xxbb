@keyframes fan-badge-dialog-in {
  from {
    opacity: 0;
    transform: translateY(30rpx) scale(0.95);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@-webkit-keyframes fan-badge-aurora {
  0%,
  100% {
    opacity: 0.45;
    transform: translateX(-50%) scale(0.96);
  }

  50% {
    opacity: 0.8;
    transform: translateX(-50%) scale(1.04);
  }
}

@keyframes fan-badge-aurora {
  0%,
  100% {
    opacity: 0.45;
    transform: translateX(-50%) scale(0.96);
  }

  50% {
    opacity: 0.8;
    transform: translateX(-50%) scale(1.04);
  }
}

@-webkit-keyframes fan-badge-stage-spin {
  to {
    transform: rotate(1turn);
  }
}

@keyframes fan-badge-stage-spin {
  to {
    transform: rotate(1turn);
  }
}

@-webkit-keyframes fan-badge-stage-spin-reverse {
  to {
    transform: rotate(-1turn);
  }
}

@keyframes fan-badge-stage-spin-reverse {
  to {
    transform: rotate(-1turn);
  }
}

@-webkit-keyframes fan-badge-avatar-float {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-5rpx);
  }
}

@keyframes fan-badge-avatar-float {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-5rpx);
  }
}

@-webkit-keyframes fan-badge-spark {
  0%,
  100% {
    opacity: 0;
    transform: scale(0.4);
  }

  45% {
    opacity: 1;
    transform: scale(1.4);
  }
}

@keyframes fan-badge-spark {
  0%,
  100% {
    opacity: 0;
    transform: scale(0.4);
  }

  45% {
    opacity: 1;
    transform: scale(1.4);
  }
}

.manual-notify-btn::after {
  border: none;
}

.manual-notify-btn.is-disabled {
  opacity: 0.55;
}

.tip-card {
  background: #fff8e8;
  border: 1rpx solid #ffdfa3;
  border-radius: 28rpx;
  margin-top: 24rpx;
  padding: 24rpx 26rpx;
}

.tip-icon {
  align-items: center;
  background: #eaa61a;
  border-radius: 14rpx;
  color: #fff;
  flex: none;
  font-size: 27rpx;
  font-weight: 800;
  height: 44rpx;
  justify-content: center;
  width: 44rpx;
}

.tip-copy,
.tip-icon {
  display: flex;
}

.tip-copy {
  flex-direction: column;
  margin-left: 18rpx;
}

.tip-title {
  color: #c26512;
  font-size: 23rpx;
  font-weight: 700;
}

.tip-subtitle {
  color: #d18a42;
  font-size: 19rpx;
  line-height: 1.5;
  margin-top: 6rpx;
}

.error-card {
  background: #fff0ee;
  border-radius: 24rpx;
  color: #be4334;
  font-size: 21rpx;
  margin-top: 20rpx;
  padding: 22rpx 26rpx;
}

@-webkit-keyframes media-anchor-row-enter {
  from {
    opacity: 0;
    transform: translateY(14rpx) scale(0.985);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes media-anchor-row-enter {
  from {
    opacity: 0;
    transform: translateY(14rpx) scale(0.985);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@-webkit-keyframes media-live-ring-breathe {
  0%,
  100% {
    opacity: 0.8;
    transform: scale(0.97);
  }

  50% {
    opacity: 1;
    transform: scale(1.025);
  }
}

@keyframes media-live-ring-breathe {
  0%,
  100% {
    opacity: 0.8;
    transform: scale(0.97);
  }

  50% {
    opacity: 1;
    transform: scale(1.025);
  }
}

@-webkit-keyframes media-live-ring-ripple {
  0% {
    opacity: 0.54;
    transform: scale(0.86);
  }

  100%,
  76% {
    opacity: 0;
    transform: scale(1.09);
  }
}

@keyframes media-live-ring-ripple {
  0% {
    opacity: 0.54;
    transform: scale(0.86);
  }

  100%,
  76% {
    opacity: 0;
    transform: scale(1.09);
  }
}

@-webkit-keyframes media-live-equalizer-wave {
  0% {
    transform: scaleY(0.3);
  }

  45% {
    transform: scaleY(1);
  }

  100% {
    transform: scaleY(0.48);
  }
}

@keyframes media-live-equalizer-wave {
  0% {
    transform: scaleY(0.3);
  }

  45% {
    transform: scaleY(1);
  }

  100% {
    transform: scaleY(0.48);
  }
}

@-webkit-keyframes media-live-dot-pulse {
  0%,
  100% {
    opacity: 1;
    transform: scale(1);
  }

  50% {
    opacity: 0.5;
    transform: scale(0.72);
  }
}

@keyframes media-live-dot-pulse {
  0%,
  100% {
    opacity: 1;
    transform: scale(1);
  }

  50% {
    opacity: 0.5;
    transform: scale(0.72);
  }
}

.theme-xiaoyu-moon-tide .live-audience-ring {
  border-color: rgba(52, 167, 184, 0.34);
}

.theme-xiaoyu-moon-tide .live-audience-core,
.theme-xiaoyu-moon-tide .live-audience-loading-dot {
  background: #3ca9ba;
  box-shadow: 0 0 9rpx rgba(60, 169, 186, 0.3);
}

.theme-xiaoyu-moon-tide .live-audience-number {
  color: #319bab;
}

.theme-xiaoyu-moon-tide .live-audience-label {
  color: #698d93;
}

.theme-xiaoyu-moon-tide .live-audience-chevron {
  color: #8cb4ba;
}

.theme-xiaoyu-moon-tide .anchor-row.is-featured,
.theme-xiaoyu-moon-tide .anchor-row.is-featured.has-top-honor,
.theme-xiaoyu-moon-tide .anchor-row.is-featured.is-live,
.theme-xiaoyu-moon-tide .anchor-row.is-featured.is-live.is-last {
  background:
    linear-gradient(
      112deg,
      hsla(0, 0%, 100%, 0.82),
      rgba(228, 248, 251, 0.92) 48%,
      rgba(234, 250, 252, 0.84)
    ),
    #f4fcfd;
  background-size: 180% 100%;
  border-color: rgba(57, 167, 184, 0.25);
  box-shadow:
    0 14rpx 32rpx rgba(47, 139, 154, 0.12),
    inset 0 1rpx 0 hsla(0, 0%, 100%, 0.98),
    inset 0 0 0 3rpx hsla(0, 0%, 100%, 0.4);
}

.theme-xiaoyu-moon-tide .anchor-row.is-featured::before {
  background: linear-gradient(90deg, #2d8d9c, #5fd0e1 26%, #e6f9fb 48%, #b19e71 72%, #2d8d9c);
  background-size: 220% 100%;
}

.theme-xiaoyu-moon-tide .anchor-featured-label {
  background: linear-gradient(108deg, #217986, #369aaa 54%, #8d7d57);
  border-color: rgba(199, 243, 246, 0.54);
  box-shadow:
    0 7rpx 16rpx rgba(41, 122, 134, 0.2),
    inset 0 1rpx 0 rgba(228, 248, 251, 0.42);
  color: #edfbfc;
}

.theme-xiaoyu-moon-tide .anchor-featured-label-mark {
  background: #92e7ed;
  box-shadow:
    0 0 0 4rpx rgba(108, 215, 231, 0.1),
    0 0 10rpx rgba(133, 228, 235, 0.62);
}

.theme-xiaoyu-moon-tide .anchor-featured-label-en {
  color: rgba(214, 245, 248, 0.68);
}

.theme-xiaoyu-moon-tide .featured-avatar-orbit {
  border-color: #319cad #b7a57b rgba(220, 246, 249, 0.32) rgba(80, 185, 201, 0.62);
  box-shadow:
    0 0 0 5rpx hsla(0, 0%, 100%, 0.56),
    0 0 14rpx rgba(67, 171, 187, 0.2);
}

.theme-xiaoyu-moon-tide .anchor-featured-beam {
  background: linear-gradient(
    90deg,
    transparent,
    rgba(76, 191, 208, 0.26),
    hsla(42, 30%, 58%, 0.46),
