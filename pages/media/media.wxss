}

.theme-xiaoyu-moon-tide .anchor-id-copy {
  background: rgba(240, 251, 252, 0.86);
  border-color: rgba(71, 178, 195, 0.18);
}

.theme-xiaoyu-moon-tide .anchor-id-copy--pressed {
  background: #e6f9fb;
  border-color: rgba(63, 179, 197, 0.32);
}

.theme-xiaoyu-moon-tide .anchor-id-prefix {
