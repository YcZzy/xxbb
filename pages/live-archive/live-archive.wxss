@-webkit-keyframes archive-signal {
  from {
    transform: scaleY(0.4);
  }

  to {
    transform: scaleY(1);
  }
}

@keyframes archive-signal {
  from {
    transform: scaleY(0.4);
  }

  to {
    transform: scaleY(1);
  }
}

@-webkit-keyframes archive-history-reveal {
  from {
    clip-path: inset(0 0 12% 0);
    transform: translateY(-4px);
  }

  to {
    clip-path: inset(0);
    transform: translateY(0);
  }
}

@keyframes archive-history-reveal {
  from {
    clip-path: inset(0 0 12% 0);
    transform: translateY(-4px);
  }

  to {
    clip-path: inset(0);
    transform: translateY(0);
  }
}

@-webkit-keyframes archive-identity-settle {
  from {
    transform: translateY(3px);
  }

  to {
    transform: translateY(0);
  }
}

@keyframes archive-identity-settle {
  from {
    transform: translateY(3px);
  }

  to {
    transform: translateY(0);
  }
}

@-webkit-keyframes archive-trend-sweep {
  0%,
  8% {
    opacity: 0;
    transform: translateX(0) skewX(-18deg);
  }

  16% {
    opacity: 1;
  }

  43% {
    opacity: 1;
    transform: translateX(430%) skewX(-18deg);
  }

  100%,
  44% {
    opacity: 0;
    transform: translateX(430%) skewX(-18deg);
  }
}

@keyframes archive-trend-sweep {
  0%,
  8% {
    opacity: 0;
    transform: translateX(0) skewX(-18deg);
  }

  16% {
    opacity: 1;
  }

  43% {
    opacity: 1;
    transform: translateX(430%) skewX(-18deg);
  }

  100%,
  44% {
    opacity: 0;
    transform: translateX(430%) skewX(-18deg);
  }
}

@-webkit-keyframes archive-trend-trace {
  0%,
  9% {
    clip-path: inset(0 0 0 0);
  }

  10% {
    clip-path: inset(0 100% 0 0);
  }

  100%,
  34% {
    clip-path: inset(0 0 0 0);
  }
}

@keyframes archive-trend-trace {
  0%,
  9% {
    clip-path: inset(0 0 0 0);
  }

  10% {
    clip-path: inset(0 100% 0 0);
  }

  100%,
  34% {
    clip-path: inset(0 0 0 0);
  }
}

@-webkit-keyframes archive-trend-invite {
  0%,
  100%,
  22%,
  46% {
    transform: translateX(0) rotate(45deg);
  }

  34% {
    transform: translateX(3px) rotate(45deg);
  }
}

@keyframes archive-trend-invite {
  0%,
  100%,
  22%,
  46% {
    transform: translateX(0) rotate(45deg);
  }

  34% {
    transform: translateX(3px) rotate(45deg);
  }
}

