page {
  background: #fff7ee;
  height: 100%;
}

button {
  background: transparent;
  border: 0;
  box-sizing: border-box;
  line-height: 1;
  margin: 0;
  padding: 0;
}

button::after {
  display: none;
}

.archive-page {
  --selector-border: rgba(143, 93, 69, 0.14);
  --selector-highlight: rgba(198, 68, 52, 0.48);
  --selector-halo: rgba(201, 70, 53, 0.07);
  --selector-shadow: rgba(154, 65, 46, 0.12);
  --scope-accent: #a32329;
  --scope-active-bg: rgba(174, 58, 48, 0.1);
  background: linear-gradient(180deg, #fff4e8, #fffaf5 36%, #fff7ef);
  color: #342823;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

.archive-page,
.custom-nav {
  box-sizing: border-box;
  display: flex;
  position: relative;
}

.custom-nav {
  align-items: center;
  background: rgba(255, 247, 238, 0.94);
  border-bottom: 1rpx solid rgba(111, 70, 53, 0.08);
  flex: none;
  justify-content: space-between;
  padding-left: 28rpx;
  padding-right: 28rpx;
  z-index: 10;
}

.nav-back,
.nav-side-space {
  flex: none;
  height: 64rpx;
  width: 72rpx;
}

.archive-tool-row {
  gap: 18rpx;
  justify-content: space-between;
  margin-bottom: 10rpx;
  min-height: 52rpx;
}

.archive-scope-switch,
.archive-tool-row {
  align-items: center;
  display: flex;
}

.archive-scope-switch {
  background: rgba(255, 252, 246, 0.58);
  border: 1rpx solid rgba(112, 76, 61, 0.1);
  border-radius: 26rpx;
  box-shadow: inset 0 1rpx 0 hsla(0, 0%, 100%, 0.76);
  box-sizing: border-box;
  height: 52rpx;
  min-width: 248rpx;
  padding: 4rpx;
}

.archive-scope-option {
  align-items: center;
  background: transparent;
  border-radius: 22rpx;
  color: rgba(89, 70, 62, 0.68);
  display: flex;
  flex: 1;
  font-size: 18rpx;
  font-weight: 750;
  height: 42rpx;
  justify-content: center;
  min-width: 0;
  padding: 0 16rpx;
  position: relative;
  transition:
    color 0.17s ease,
    background-color 0.17s ease,
    -webkit-transform 0.15s ease;
  transition:
    color 0.17s ease,
    background-color 0.17s ease,
    transform 0.15s ease;
  transition:
    color 0.17s ease,
    background-color 0.17s ease,
    transform 0.15s ease,
    -webkit-transform 0.15s ease;
  white-space: nowrap;
}

.archive-scope-option.is-active {
  background: var(--scope-active-bg);
  box-shadow:
    0 4rpx 11rpx rgba(100, 50, 39, 0.07),
    inset 0 1rpx 0 hsla(0, 0%, 100%, 0.82);
  color: var(--scope-accent);
}

.archive-scope-option.is-active::after {
  background: currentColor;
  border-radius: 2rpx;
  bottom: 4rpx;
  content: '';
  height: 2rpx;
  left: 20rpx;
  opacity: 0.38;
  position: absolute;
  right: 20rpx;
}

.archive-scope-option--pressed {
  transform: scale(0.95);
}

.archive-trend-entry {
  align-items: center;
  background: rgba(255, 252, 246, 0.74);
  border: 1rpx solid rgba(171, 56, 47, 0.12);
  border-radius: 26rpx;
  box-shadow: 0 7rpx 18rpx rgba(111, 50, 39, 0.07);
  color: #a32329;
  display: flex;
  flex: none;
  height: 52rpx;
  justify-content: center;
  transition:
    background 0.15s ease,
    -webkit-transform 0.15s ease;
  transition:
    background 0.15s ease,
    transform 0.15s ease;
  transition:
    background 0.15s ease,
    transform 0.15s ease,
    -webkit-transform 0.15s ease;
  width: 166rpx;
}

.archive-trend-entry--pressed {
  background: rgba(255, 238, 223, 0.92);
  transform: scale(0.95);
}

.nav-trend-icon {
  flex: none;
  height: 29rpx;
  position: relative;
  width: 34rpx;
}

.archive-trend-label {
  font-size: 19rpx;
  font-weight: 850;
  margin-left: 11rpx;
}

.nav-trend-axis {
  background: currentColor;
  border-radius: 999rpx;
  opacity: 0.28;
  position: absolute;
}

.nav-trend-axis.axis-x {
  bottom: 2rpx;
  height: 2rpx;
  left: 4rpx;
  right: 1rpx;
}

.nav-trend-axis.axis-y {
  bottom: 2rpx;
  left: 4rpx;
  top: 2rpx;
  width: 2rpx;
}

.nav-trend-line {
  background: currentColor;
  border-radius: 999rpx;
  box-shadow: 0 0 7rpx rgba(179, 48, 43, 0.2);
  height: 3rpx;
  position: absolute;
  transform-origin: left center;
}

.nav-trend-line.line-one {
  left: 8rpx;
  top: 20rpx;
  transform: rotate(-34deg);
  width: 15rpx;
}

.nav-trend-line.line-two {
  left: 20rpx;
  top: 11rpx;
  transform: rotate(24deg);
  width: 14rpx;
}

.nav-trend-dot {
  background: currentColor;
  border: 2rpx solid #fff8ef;
  border-radius: 50%;
  box-shadow: 0 0 0 2rpx currentColor;
  height: 6rpx;
  position: absolute;
  width: 6rpx;
}

.nav-trend-dot.dot-one {
  bottom: 6rpx;
  left: 6rpx;
}

.nav-trend-dot.dot-two {
  left: 19rpx;
  top: 7rpx;
}

.nav-trend-dot.dot-three {
  right: 1rpx;
  top: 12rpx;
}

.archive-trend-entry .nav-trend-dot.dot-two {
  animation: nav-trend-pulse 2s ease-in-out infinite;
}

.nav-back {
  align-items: center;
  border-radius: 16rpx;
  display: flex;
  justify-content: center;
}

.nav-back--pressed {
  background: rgba(191, 56, 47, 0.08);
  transform: scale(0.94);
}

.nav-back-chevron {
  border-bottom: 4rpx solid #3f312c;
  border-left: 4rpx solid #3f312c;
  height: 20rpx;
  transform: rotate(45deg);
  width: 20rpx;
}

.nav-title-group {
  align-items: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.custom-nav-title {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.2;
}

.archive-scroll {
  flex: 1;
  min-height: 0;
}

.archive-content {
  box-sizing: border-box;
  padding: 20rpx 20rpx 0;
  position: relative;
  width: 100%;
  z-index: 1;
}

.archive-disclaimer {
  align-items: flex-start;
  background: rgba(255, 252, 247, 0.34);
  border-bottom: 1rpx solid rgba(139, 94, 75, 0.08);
  border-top: 1rpx solid rgba(139, 94, 75, 0.08);
  color: rgba(100, 78, 69, 0.72);
  display: flex;
  margin: 12rpx 4rpx 2rpx;
  padding: 10rpx 12rpx;
}

.archive-disclaimer-mark {
  align-items: center;
  border: 2rpx solid rgba(167, 86, 66, 0.42);
  border-radius: 50%;
  box-sizing: border-box;
  color: rgba(152, 68, 54, 0.76);
  display: flex;
  flex: none;
  font-size: 17rpx;
  font-weight: 800;
  height: 25rpx;
  justify-content: center;
  line-height: 1;
  margin-top: 1rpx;
  width: 25rpx;
}

.archive-disclaimer-copy {
  font-size: 18rpx;
  line-height: 1.55;
  margin-left: 10rpx;
  min-width: 0;
}

.date-step {
  align-items: center;
  background: rgba(255, 250, 244, 0.78);
  border: 1rpx solid rgba(130, 86, 66, 0.12);
  border-radius: 14rpx;
  box-shadow: inset 0 1rpx 0 hsla(0, 0%, 100%, 0.82);
  display: flex;
  justify-content: center;
  transition:
    opacity 0.14s ease,
    border-color 0.14s ease,
    -webkit-transform 0.14s ease;
  transition:
    transform 0.14s ease,
    opacity 0.14s ease,
    border-color 0.14s ease;
  transition:
    transform 0.14s ease,
    opacity 0.14s ease,
    border-color 0.14s ease,
    -webkit-transform 0.14s ease;
}

.date-step.is-disabled {
  opacity: 0.3;
}

.date-step--pressed {
  transform: scale(0.9);
}

.date-chevron {
  border-bottom: 3rpx solid #856f65;
  border-left: 3rpx solid #856f65;
  height: 14rpx;
  width: 14rpx;
}

.date-chevron.is-left {
  transform: rotate(45deg);
}

.date-chevron.is-right {
  transform: rotate(225deg);
}

.anchor-avatar-shell {
  flex: none;
  height: 70rpx;
  position: relative;
  width: 70rpx;
}

.anchor-avatar {
  align-items: center;
  background: #f3d8bf;
  box-shadow: 0 8rpx 22rpx rgba(120, 58, 40, 0.15);
  color: #a33930;
  display: flex;
  font-size: 27rpx;
  font-weight: 800;
  height: 70rpx;
  justify-content: center;
  overflow: hidden;
  width: 70rpx;
}

.anchor-avatar,
.live-dot,
.option-live-dot {
  border: 4rpx solid #fff;
  border-radius: 50%;
  box-sizing: border-box;
}

.live-dot,
.option-live-dot {
  background: #e84a3f;
  bottom: 3rpx;
  box-shadow: 0 0 14rpx rgba(232, 74, 63, 0.55);
  height: 19rpx;
  position: absolute;
  right: 0;
  width: 19rpx;
}

.anchor-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  padding: 0 14rpx;
}

.anchor-name {
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.25;
  margin-top: 3rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selector-cue-chevron {
  border-bottom: 3rpx solid;
