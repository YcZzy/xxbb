  70% {
    opacity: 1;
    transform: translateY(-4rpx) scale(1.004);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@-webkit-keyframes calendar-panel-out {
  from {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  to {
    opacity: 0;
    transform: translateY(36rpx) scale(0.98);
  }
}

@keyframes calendar-panel-out {
  from {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  to {
    opacity: 0;
    transform: translateY(36rpx) scale(0.98);
  }
}

@media (prefers-reduced-motion: reduce) {
  .date-selector-layer,
  .date-selector-panel,
  .is-number-updating .is-changing,
  .nav-trend-dot,
  .pk-detail-sheet,
  .pk-section-chevron,
  .state-loader-core,
  .state-loader-ring,
  .summary-band,
  .summary-band::before,
  .summary-value {
    animation: none;
  }
}

