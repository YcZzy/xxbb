.entry-page,
page {
  background: #fff;
}

.entry-page {
  --accent: #b72f53;
  --ink: #302a32;
  --muted: #756773;
  align-items: center;
  box-sizing: border-box;
  color: var(--ink);
  display: flex;
  flex-direction: column;
  letter-spacing: 0;
  min-height: 100vh;
  padding: 120px 28px 48px;
}

.theme-siwuliu-ice {
  --accent: #21718e;
}

.theme-xiaoyu-moon-tide {
  --accent: #247b72;
}

.entry-mark {
  height: 64px;
  margin-bottom: 24px;
  width: 64px;
}

.entry-title {
  font-size: 20px;
  font-weight: 600;
  line-height: 1.5;
  max-width: 100%;
}

.entry-message,
.entry-title {
  overflow-wrap: anywhere;
  text-align: center;
}

.entry-message {
  color: var(--muted);
  font-size: 15px;
  line-height: 1.7;
  margin-top: 12px;
  max-width: 320px;
}

.entry-actions {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 28px;
  max-width: 320px;
  width: 100%;
}

.entry-page button {
  border-radius: 8px;
  font-size: 16px;
  line-height: 24px;
  margin: 0;
  min-height: 48px;
  padding: 12px 20px;
  transition: opacity 0.16s;
  width: 100%;
}

.entry-page button::after {
  border: 0;
}

.entry-page .entry-primary {
  background: var(--accent);
  color: #fff;
}

.entry-page .entry-home {
  background: transparent;
  color: var(--accent);
}

.entry-pressed {
  opacity: 0.65;
}

@media (prefers-reduced-motion: reduce) {
  .entry-page button {
    transition: none;
  }
}
