}

.custom-nav {
  align-items: flex-end;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  padding-bottom: 14rpx;
  position: relative;
}

.custom-nav-title {
  animation: home-nav-enter 0.48s cubic-bezier(0.2, 0.78, 0.24, 1) both;
  color: #2a2220;
  font-size: 30rpx;
  font-weight: 700;
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.custom-nav-title.is-guide-covered {
  visibility: hidden;
}

.custom-service-entry {
  align-items: center;
  background: rgba(255, 252, 247, 0.74);
  border: 1rpx solid rgba(126, 94, 80, 0.13);
  border-radius: 999rpx;
  box-shadow: 0 6rpx 16rpx rgba(92, 53, 42, 0.06);
  box-sizing: border-box;
  color: #8c7c75;
  display: flex;
  font-size: 19rpx;
  font-weight: 720;
  height: 48rpx;
  justify-content: center;
  line-height: 1;
  margin: 0;
  min-width: 98rpx;
  opacity: 0.76;
  padding: 0 16rpx;
  position: absolute;
  right: -2rpx;
  top: 38rpx;
  transition:
    opacity 0.15s ease,
    color 0.15s ease,
    background 0.15s ease,
    -webkit-transform 0.15s ease;
  transition:
    opacity 0.15s ease,
    transform 0.15s ease,
    color 0.15s ease,
    background 0.15s ease;
  transition:
    opacity 0.15s ease,
    transform 0.15s ease,
    color 0.15s ease,
    background 0.15s ease,
    -webkit-transform 0.15s ease;
  z-index: 7;
}

.custom-service-entry::after {
  border: 0;
}

.custom-service-entry-mark {
  color: #c28745;
  font-size: 16rpx;
  margin-right: 7rpx;
}

.custom-service-entry--pressed {
  background: rgba(255, 248, 239, 0.9);
  color: #ad4538;
  opacity: 1;
  transform: scale(0.94);
}

