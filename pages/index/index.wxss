.mascot-stage.skin-siwuliu-ice::before {
  border-color: rgba(132, 208, 238, 0.88) rgba(174, 139, 221, 0.5) rgba(108, 175, 222, 0.22)
    rgba(108, 175, 222, 0.22);
  box-shadow: inset 0 0 34rpx rgba(211, 239, 249, 0.2);
}

.mascot-stage.skin-siwuliu-ice::after {
  border-color: rgba(106, 177, 222, 0.42);
}

.mascot-stage.skin-siwuliu-ice.state-normal .mascot-motion {
  animation-duration: 6.4s;
}

.mascot-stage.skin-siwuliu-ice .mascot-bubble {
  border-color: rgba(86, 158, 211, 0.25);
  box-shadow: 0 12rpx 30rpx rgba(66, 121, 166, 0.15);
  color: #3f536c;
}

.mascot-stage.skin-siwuliu-ice .mascot-bubble-tail {
  border-bottom-color: rgba(86, 158, 211, 0.25);
  border-right-color: rgba(86, 158, 211, 0.25);
}

.mascot-stage.skin-siwuliu-ice .mascot-floor {
  background: rgba(69, 118, 153, 0.15);
}

.mascot-stage.skin-siwuliu-ice .mascot-spark {
  background: #78c9e9;
}

.mascot-stage.skin-xiaoyu-moon-tide::before {
  animation-duration: 6.8s;
  border-color: rgba(87, 211, 216, 0.9) hsla(39, 78%, 67%, 0.58) rgba(52, 183, 195, 0.2)
    rgba(52, 183, 195, 0.2);
  box-shadow: inset 0 0 36rpx rgba(207, 248, 249, 0.24);
}

.mascot-stage.skin-xiaoyu-moon-tide::after {
  border-color: rgba(53, 168, 189, 0.4);
  box-shadow: 0 0 28rpx rgba(56, 189, 199, 0.14);
}

.mascot-stage.skin-xiaoyu-moon-tide .mascot-image {
  transform: scale(1.04);
}

.mascot-stage.skin-xiaoyu-moon-tide.state-leave .mascot-motion,
.mascot-stage.skin-xiaoyu-moon-tide.state-normal .mascot-motion {
  animation: xiaoyu-moon-tide-wait 5.4s ease-in-out infinite;
}

.mascot-stage.skin-xiaoyu-moon-tide.state-live .mascot-motion {
  animation: xiaoyu-moon-tide-live 1.7s ease-in-out infinite;
}

.mascot-stage.skin-xiaoyu-moon-tide.is-state-changing .mascot-motion {
  animation: mascot-state-settle 0.72s cubic-bezier(0.16, 0.86, 0.24, 1.08) both;
}

.mascot-stage.skin-xiaoyu-moon-tide .mascot-bubble {
