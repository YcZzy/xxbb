.bell-icon::after {
  border: 3rpx solid rgba(217, 58, 47, 0.3);
  border-radius: 50%;
  content: '';
  inset: -5rpx;
  opacity: 0;
  pointer-events: none;
  position: absolute;
}

.bell-icon.is-success::after {
  animation: notification-confirm-ring 0.72s ease-out both;
}

.bell-icon.is-success .bell-body,
.bell-icon.is-success .bell-clapper {
  animation: notification-bell-ring 0.76s ease-in-out both;
  transform-origin: 50% 8%;
}

.notify-number-viewport {
  display: block;
  height: 92rpx;
  min-width: 150rpx;
  overflow: hidden;
  text-align: center;
}

.notify-number-stack {
  height: 184rpx;
}

.notify-number-stack.is-rolling {
  animation: notification-number-roll 0.62s cubic-bezier(0.2, 0.82, 0.28, 1) both;
}

.notify-number-frame {
  align-items: center;
  box-sizing: border-box;
  display: flex;
  height: 92rpx;
  justify-content: center;
}

.notify-counter.is-success .notify-label {
  animation: notification-label-confirm 0.66s ease-out both;
}

.primary-button.is-success {
  animation: notification-button-confirm 0.72s cubic-bezier(0.18, 0.86, 0.24, 1) both;
}

.leave-icon.is-success,
.work-icon.is-success {
  animation: notification-leave-confirm 0.72s cubic-bezier(0.18, 0.86, 0.24, 1) both;
}

@-webkit-keyframes notification-number-roll {
