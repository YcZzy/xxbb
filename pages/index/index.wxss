.mascot-stage {
  animation: home-mascot-enter 0.72s cubic-bezier(0.16, 0.88, 0.24, 1.08) 90ms both;
  flex: none;
  height: 306rpx;
  margin-left: -26rpx;
  overflow: visible;
  position: relative;
  width: 318rpx;
}

.starlight-mascot-host {
  height: 306rpx;
  left: 6rpx;
  position: absolute;
  top: 0;
  width: 306rpx;
  z-index: 2;
}

.mascot-stage.skin-ibo-starlight .mascot-floor,
.mascot-stage.skin-ibo-starlight .mascot-spark,
.mascot-stage.skin-ibo-starlight::after,
.mascot-stage.skin-ibo-starlight::before {
  display: none;
}

.skin-card-ibo-starlight .mascot-skin-card-orbit {
  border-color: rgba(206, 149, 67, 0.18);
}

.mascot-stage::before {
  animation: mascot-orbit-idle 9s linear infinite;
  border-color: rgba(238, 166, 45, 0.66) rgba(217, 58, 47, 0.38) rgba(218, 83, 56, 0.12)
    rgba(218, 83, 56, 0.12);
  border-radius: 50%;
  border-style: solid;
  border-width: 2rpx;
  bottom: 30rpx;
  height: 224rpx;
  right: 28rpx;
  width: 224rpx;
  z-index: 0;
}

.mascot-stage::after,
.mascot-stage::before {
  box-sizing: border-box;
  content: '';
  pointer-events: none;
  position: absolute;
}

.mascot-stage::after {
  border: 4rpx solid rgba(217, 58, 47, 0.28);
  border-radius: 50%;
  bottom: 50rpx;
  height: 184rpx;
  opacity: 0;
  right: 48rpx;
  width: 184rpx;
  z-index: 1;
}

.mascot-stage.state-leave::before {
  animation: mascot-orbit-rest 6.8s ease-in-out infinite;
  border-color: rgba(235, 171, 55, 0.66) rgba(211, 139, 40, 0.18) rgba(211, 139, 40, 0.18)
    rgba(101, 151, 121, 0.34);
}

.mascot-stage.state-live::before {
  animation-duration: 2.8s;
  border-color: rgba(66, 188, 229, 0.78) rgba(217, 58, 47, 0.48) rgba(32, 134, 205, 0.2)
    rgba(32, 134, 205, 0.2);
}

.mascot-stage.is-state-changing::after {
  animation: mascot-state-ring 0.72s cubic-bezier(0.18, 0.82, 0.28, 1) both;
}

.mascot-stage.state-leave.is-state-changing::after {
  border-color: rgba(219, 154, 48, 0.42);
}

.mascot-stage.state-live.is-state-changing::after {
  border-color: rgba(37, 156, 218, 0.46);
}

.mascot-stage-hover {
  opacity: 0.9;
}

.mascot-bubble {
  animation: mascot-bubble-in 0.24s ease-out both;
  background: hsla(0, 0%, 100%, 0.98);
  border: 2rpx solid rgba(217, 58, 47, 0.2);
  border-radius: 22rpx 22rpx 5rpx 22rpx;
  box-shadow: 0 12rpx 30rpx rgba(122, 56, 43, 0.15);
  box-sizing: border-box;
  color: #5b302a;
  font-size: 22rpx;
  font-weight: 750;
  line-height: 1.45;
  padding: 17rpx 20rpx;
  pointer-events: none;
  position: absolute;
  right: -2rpx;
  text-align: center;
  top: -38rpx;
  width: 272rpx;
  z-index: 5;
}

.mascot-bubble-tail {
  background: #fff;
  border-bottom: 2rpx solid rgba(217, 58, 47, 0.2);
  border-right: 2rpx solid rgba(217, 58, 47, 0.2);
  bottom: -15rpx;
  height: 24rpx;
  position: absolute;
  right: 52rpx;
  transform: rotate(45deg);
  width: 24rpx;
}

.mascot-motion {
  animation: mascot-breathe 3.8s ease-in-out infinite;
  bottom: 12rpx;
  left: 0;
  position: absolute;
  right: 0;
  top: 0;
  z-index: 2;
}

.mascot-image,
.mascot-motion {
  transform-origin: 50% 88%;
}

.mascot-image {
  height: 100%;
  width: 100%;
}

.mascot-stage.is-waving .mascot-image {
  animation: mascot-wave-pop 0.92s ease-out;
}

.mascot-stage.is-state-changing .mascot-motion {
  animation: mascot-state-settle 0.72s cubic-bezier(0.16, 0.86, 0.24, 1.08) both;
}

.mascot-stage.state-leave .mascot-motion {
  animation: mascot-leave-rock 2.1s ease-in-out infinite;
  transform-origin: 50% 82%;
}

.mascot-stage.state-live .mascot-motion {
  animation: mascot-live-focus 1.15s ease-in-out infinite;
  transform-origin: 50% 90%;
}

.mascot-floor {
  animation: mascot-floor-breathe 3.8s ease-in-out infinite;
  background: rgba(98, 59, 43, 0.13);
  border-radius: 50%;
  bottom: 8rpx;
  filter: blur(4rpx);
  height: 15rpx;
  position: absolute;
  right: 39rpx;
  transform-origin: center;
  width: 218rpx;
  z-index: 1;
}

.mascot-stage.state-leave .mascot-floor {
  animation-duration: 2.1s;
  background: rgba(83, 63, 46, 0.14);
  bottom: 6rpx;
  right: 25rpx;
  width: 260rpx;
}

.mascot-stage.state-live .mascot-floor {
  animation-duration: 1.15s;
  background: rgba(34, 84, 113, 0.14);
  bottom: 4rpx;
  right: 28rpx;
  width: 254rpx;
}

.mascot-spark {
  background: #f0aa2c;
  border-radius: 5rpx;
  height: 5rpx;
  opacity: 0.72;
  position: absolute;
  right: 22rpx;
  transform: rotate(-18deg);
  width: 34rpx;
  z-index: 0;
}

.mascot-spark-one {
  animation: mascot-spark-flicker 2.4s ease-in-out infinite;
  top: 56rpx;
}

.mascot-spark-two {
  animation: mascot-spark-flicker 2.4s ease-in-out 0.72s infinite;
  right: 12rpx;
  top: 75rpx;
  width: 22rpx;
}

