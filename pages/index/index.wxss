  align-items: center;
  animation: home-campaign-modal-in 0.48s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  background:
    radial-gradient(circle at 50% 4%, rgba(255, 195, 75, 0.34), transparent 32%),
    linear-gradient(158deg, #fffdf8, #fff7ed 54%, #ffead9);
  border: 2rpx solid rgba(255, 211, 137, 0.76);
  border-radius: 16rpx;
  box-shadow:
    0 42rpx 90rpx rgba(73, 26, 20, 0.32),
    inset 0 0 0 2rpx hsla(0, 0%, 100%, 0.72);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  max-width: 620rpx;
  min-height: 760rpx;
  overflow: hidden;
  padding: 88rpx 48rpx 42rpx;
  position: relative;
  text-align: center;
  width: 100%;
}

.home-campaign-modal::before {
  border: 2rpx solid rgba(205, 60, 43, 0.1);
  border-radius: 50%;
  content: '';
  height: 340rpx;
  left: 50%;
  position: absolute;
  top: -164rpx;
  transform: translateX(-50%);
  width: 520rpx;
}

.home-campaign-modal::after {
  background: linear-gradient(90deg, transparent, rgba(200, 73, 47, 0.18), transparent);
  bottom: 24rpx;
  content: '';
  height: 2rpx;
  left: 32rpx;
