.page-shell .favorite-anchor-switch {
  --favorite-switch-surface: linear-gradient(135deg, #b73832, #922635);
  --favorite-switch-shadow: rgba(152, 41, 45, 0.18);
  align-items: center;
  background: transparent !important;
  border: 0 !important;
  border-radius: 8px;
  box-shadow: none !important;
  box-sizing: border-box;
  color: #fff !important;
  display: flex;
  flex: none;
  font-size: 12px;
  font-weight: 600;
  justify-content: center;
  letter-spacing: 0;
  line-height: 1.4;
  margin: 0;
  min-height: 44px;
  padding: 0;
  white-space: nowrap;
  width: 84px;
}

.favorite-anchor-switch::after {
  border: 0;
}

.favorite-anchor-switch-face {
  align-items: center;
  background: var(--favorite-switch-surface);
  border-radius: 8px;
  box-shadow:
    0 3px 8px var(--favorite-switch-shadow),
    inset 0 1px 0 hsla(0, 0%, 100%, 0.22);
  box-sizing: border-box;
  display: flex;
  gap: 6px;
  height: 30px;
  justify-content: center;
  overflow: hidden;
  padding: 0 8px;
  position: relative;
  transition:
    opacity 0.12s ease-out,
    -webkit-transform 0.12s ease-out;
  transition:
    transform 0.12s ease-out,
    opacity 0.12s ease-out;
  transition:
    transform 0.12s ease-out,
    opacity 0.12s ease-out,
    -webkit-transform 0.12s ease-out;
  width: 100%;
}

.favorite-anchor-switch-shine {
  animation: favorite-switch-sweep 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.64s both;
  background: linear-gradient(90deg, transparent, hsla(0, 0%, 100%, 0.18), transparent);
  height: 50px;
  left: -24px;
  opacity: 0;
  pointer-events: none;
  position: absolute;
  top: -10px;
  width: 16px;
}

.favorite-anchor-switch-icon {
  display: block;
  flex: none;
  height: 14px;
  transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  transition:
    transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
    -webkit-transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  width: 14px;
}

.favorite-anchor-switch--pressed .favorite-anchor-switch-face {
  opacity: 0.88;
  transform: scale(0.96);
}

.favorite-anchor-switch--pressed .favorite-anchor-switch-icon {
  transform: rotate(180deg);
}

.favorite-anchor-switch:focus-visible {
  outline: 2px solid #a33236;
  outline-offset: 2px;
}

@-webkit-keyframes favorite-switch-sweep {
  0% {
    opacity: 0;
    transform: translateX(0) skewX(-18deg);
  }

  20% {
    opacity: 1;
  }

  100% {
    opacity: 0;
    transform: translateX(132px) skewX(-18deg);
  }
}

@keyframes favorite-switch-sweep {
  0% {
    opacity: 0;
    transform: translateX(0) skewX(-18deg);
  }

  20% {
    opacity: 1;
  }

  100% {
    opacity: 0;
    transform: translateX(132px) skewX(-18deg);
  }
}

.favorite-anchor-switch-face.is-covered .favorite-anchor-switch-shine,
.performance-lite .favorite-anchor-switch-shine {
  animation: none;
}

.performance-lite .favorite-anchor-switch--pressed .favorite-anchor-switch-face,
.performance-lite .favorite-anchor-switch--pressed .favorite-anchor-switch-icon {
  transform: none;
}

.performance-lite .favorite-anchor-switch-face,
.performance-lite .favorite-anchor-switch-icon {
  transition-property: opacity;
}

@media (prefers-reduced-motion: reduce) {
  .favorite-anchor-switch-shine {
    animation: none;
  }

  .favorite-anchor-switch-face,
  .favorite-anchor-switch-icon {
    transition-property: opacity;
  }

  .favorite-anchor-switch--pressed .favorite-anchor-switch-face,
  .favorite-anchor-switch--pressed .favorite-anchor-switch-icon {
    transform: none;
  }
}

