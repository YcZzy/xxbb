.theme-transition-wave {
  height: 76rpx;
  margin: -38rpx 0 0 -38rpx;
  pointer-events: none;
  position: fixed;
  width: 76rpx;
  z-index: 900;
}

.theme-transition-wave__core,
.theme-transition-wave__ring {
  border-radius: 50%;
  inset: 0;
  opacity: 0;
  position: absolute;
  transform: scale(0.08);
  will-change: opacity, transform;
}

.theme-transition-wave--siwuliu_ice .theme-transition-wave__core {
  background: radial-gradient(
    circle at 42% 38%,
    #f8fdff 0,
    #c8efff 24%,
    #69c6ea 52%,
    #347ead 76%,
    #245b88 100%
  );
  box-shadow: 0 0 70rpx rgba(86, 200, 239, 0.72);
}

.theme-transition-wave--xiaoyu_moon_tide .theme-transition-wave__core {
  background: radial-gradient(
    circle at 42% 38%,
    #fffdf2 0,
    #c8f6f7 24%,
    #52cbd0 52%,
    #2784a0 76%,
    #234b70 100%
  );
  box-shadow: 0 0 70rpx rgba(63, 196, 204, 0.7);
}

.theme-transition-wave--classic .theme-transition-wave__core {
  background: radial-gradient(
    circle at 42% 38%,
    #fffdf8 0,
    #ffe7c8 25%,
    #f1a05b 54%,
    #d94a3d 78%,
    #b82b31 100%
  );
  box-shadow: 0 0 70rpx rgba(231, 116, 66, 0.65);
}

.theme-transition-wave__ring {
  border: 3rpx solid hsla(0, 0%, 100%, 0.88);
  box-shadow: 0 0 22rpx hsla(0, 0%, 100%, 0.75);
}

.theme-transition-wave.is-active .theme-transition-wave__core {
  animation: theme-wave-expand 0.82s cubic-bezier(0.18, 0.72, 0.24, 1) both;
}

.theme-transition-wave.is-active .theme-transition-wave__ring {
  animation: theme-wave-ring 0.72s ease-out 40ms both;
}

.theme-transition-wave__spark {
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 0 12rpx hsla(0, 0%, 100%, 0.96);
  height: 9rpx;
  opacity: 0;
  position: absolute;
  width: 9rpx;
}

.theme-transition-wave__spark.spark-one {
  right: 4rpx;
  top: -2rpx;
}

.theme-transition-wave__spark.spark-two {
  bottom: 7rpx;
  right: -7rpx;
}

.theme-transition-wave.is-active .spark-one {
  animation: theme-wave-spark-one 0.64s ease-out 70ms both;
}

.theme-transition-wave.is-active .spark-two {
  animation: theme-wave-spark-two 0.64s ease-out 0.13s both;
}

