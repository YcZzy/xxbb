.page-shell {
  background:
    radial-gradient(circle at 100% 8%, rgba(243, 182, 63, 0.3), transparent 34%),
    radial-gradient(circle at 0 30%, rgba(217, 58, 47, 0.1), transparent 32%),
    linear-gradient(180deg, #fff2df, #fffaf3 48%, #f7f1eb);
