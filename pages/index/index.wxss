  border-right-color: rgba(42, 164, 184, 0.26);
}

.mascot-stage.skin-xiaoyu-moon-tide .mascot-floor {
  opacity: 0;
}

.mascot-stage.skin-xiaoyu-moon-tide .mascot-spark {
  background: #50cbd0;
  box-shadow:
    0 0 12rpx rgba(80, 203, 208, 0.72),
