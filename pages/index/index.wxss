}

.mascot-skin-overlay {
  --collection-accent: #be4350;
  --collection-soft: #fbece9;
  align-items: center;
  animation: mascot-skin-overlay-in 0.18s ease-out both;
  background: rgba(39, 25, 24, 0.48);
  box-sizing: border-box;
  display: flex;
  inset: 0;
  justify-content: center;
  padding: 34rpx 24rpx calc(34rpx + env(safe-area-inset-bottom));
  position: fixed;
  z-index: 160;
}

.mascot-skin-overlay.theme-siwuliu-ice {
  --collection-accent: #377a9f;
  --collection-soft: #e9f4fa;
}

.mascot-skin-overlay.theme-xiaoyu-moon-tide {
  --collection-accent: #267f89;
  --collection-soft: #e7f5f4;
}

.mascot-skin-sheet {
  animation: mascot-skin-sheet-in 0.36s cubic-bezier(0.18, 0.86, 0.24, 1) both;
  background: #fffaf5;
  border: 1rpx solid hsla(0, 0%, 100%, 0.8);
  border-radius: 34rpx;
  box-shadow: 0 28rpx 76rpx rgba(49, 31, 34, 0.28);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  height: 78vh;
  max-height: 1120rpx;
  overflow: hidden;
  padding: 12px 16px;
  position: relative;
  width: 100%;
}

.theme-siwuliu-ice .mascot-skin-sheet,
.theme-xiaoyu-moon-tide .mascot-skin-sheet {
  background: #f9fcfc;
}

.mascot-skin-sheet-heading {
  align-items: center;
  display: flex;
  flex: none;
  gap: 8px;
  justify-content: space-between;
  min-height: 44px;
}

.mascot-skin-sheet-title {
  color: #302725;
  font-size: 18px;
  font-weight: 700;
  line-height: 1.4;
  min-width: 0;
}

.mascot-collection-tabs {
  border-bottom: 1px solid #e8dfd8;
  display: grid;
  flex: none;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  height: 48px;
  margin-top: 4px;
  position: relative;
}

.mascot-skin-sheet .mascot-collection-tab {
  align-items: center;
  background: transparent !important;
  border-radius: 8px 8px 0 0;
  box-shadow: none !important;
  color: #7b6863 !important;
  display: flex;
  font-size: 15px;
  font-weight: 500;
  height: 48px;
  justify-content: center;
  line-height: 1;
  margin: 0;
  min-width: 0;
  padding: 0;
  transition:
    color 0.16s ease,
    background-color 0.16s ease;
  width: 100%;
}

.mascot-skin-sheet .mascot-collection-tab::after {
  border: 0;
}

.mascot-collection-tab-label {
  position: relative;
}

.mascot-collection-new-badge {
  align-items: center;
  background: #c93448;
  border-radius: 5px 5px 5px 1px;
  color: #fff;
  display: flex;
  font-size: 11px;
  font-weight: 600;
  height: 18px;
  justify-content: center;
  left: 100%;
  letter-spacing: 0;
  line-height: 1;
  margin-left: 5px;
  pointer-events: none;
  position: absolute;
  top: -8px;
  width: 18px;
}

.mascot-skin-sheet .mascot-collection-tab.is-active {
  color: var(--collection-accent) !important;
  font-weight: 700;
}

.mascot-skin-sheet .mascot-collection-tab--pressed {
  background: var(--collection-soft) !important;
}

.mascot-collection-tab-indicator {
  bottom: -1px;
  height: 3px;
  left: 0;
  pointer-events: none;
  position: absolute;
  transition: transform 0.24s cubic-bezier(0.16, 1, 0.3, 1);
  transition:
    transform 0.24s cubic-bezier(0.16, 1, 0.3, 1),
    -webkit-transform 0.24s cubic-bezier(0.16, 1, 0.3, 1);
  width: 50%;
  z-index: 1;
}

.mascot-collection-tab-indicator::after {
  background: var(--collection-accent);
  border-radius: 2px;
  content: '';
  display: block;
  height: 3px;
  margin: 0 auto;
  width: 28px;
}

.mascot-collection-tabs.is-theme .mascot-collection-tab-indicator {
  transform: translateX(100%);
}

.mascot-collection-body {
  flex: 1;
  margin-top: 12px;
  min-height: 0;
  overflow: hidden;
  position: relative;
}

.mascot-collection-scroll {
  height: 100%;
  inset: 0;
  position: absolute;
  width: 100%;
}

.mascot-collection-panel-content {
  animation: mascot-collection-panel-in 0.22s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.collection-panel-skin {
  --collection-enter-offset: -8px;
}

.collection-panel-theme {
  --collection-enter-offset: 8px;
}

@-webkit-keyframes mascot-collection-panel-in {
  from {
    opacity: 0.7;
    transform: translateX(var(--collection-enter-offset));
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes mascot-collection-panel-in {
  from {
    opacity: 0.7;
    transform: translateX(var(--collection-enter-offset));
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.mascot-collection-current {
  align-items: baseline;
  color: #7b6863;
  display: flex;
  font-size: 11px;
  gap: 8px;
  line-height: 1.5;
  padding: 4px 0 10px;
}

.mascot-collection-current-name {
  color: #463630;
  font-weight: 600;
  min-width: 0;
  overflow-wrap: anywhere;
}

.mascot-skin-sheet .mascot-skin-sheet-close {
  align-items: center;
  background: transparent !important;
  border-radius: 50%;
  box-shadow: none !important;
