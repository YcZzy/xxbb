<call-broadcast></call-broadcast>
<view class="page-shell theme-{{mascotThemeClass}} {{performanceClass}} {{!mascotMotionEnabled||mascotSkinSheetVisible||favoritePickerVisible||customServiceDialogVisible||favoriteAnchorRequestDialogVisible||favoriteRechargeVisible||homePopupVisible||zapPanelMounted||themeTransitionVisible?'soft-gold-paused':''}}">
    <soft-gold-atmosphere active="{{mascotMotionEnabled&&!mascotSkinSheetVisible&&!favoritePickerVisible&&!customServiceDialogVisible&&!favoriteAnchorRequestDialogVisible&&!favoriteRechargeVisible&&!homePopupVisible&&!zapPanelMounted&&!themeTransitionVisible}}" aria-hidden="true" lite="{{performanceClass!==''}}" wx:if="{{selectedMascotTheme==='ibo_soft_gold'&&(softGoldPreviewAllowed||softGoldOwned)}}"></soft-gold-atmosphere>
    <view aria-hidden="true" class="theme-transition-wave theme-transition-wave--{{themeTransitionTarget}} {{themeTransitionActive?'is-active':''}}" style="{{themeTransitionOriginStyle}}" wx:if="{{themeTransitionVisible}}">
        <view class="theme-transition-wave__core"></view>
        <view class="theme-transition-wave__ring"></view>
        <view class="theme-transition-wave__spark spark-one"></view>
        <view class="theme-transition-wave__spark spark-two"></view>
    </view>
    <view class="custom-nav" style="height:{{navigationHeight}}px;padding-top:{{statusBarHeight}}px;">
        <view aria-label="{{mascotThemeHasNew?'切换形象与主题，有新主题':'切换形象与主题'}}" aria-role="button" catchtap="openMascotSkinSheet" class="mascot-collection-trigger" hover-class="mascot-collection-trigger--pressed">
            <view class="mascot-collection-trigger-halo"></view>
            <view class="mascot-collection-trigger-core">
                <view class="mascot-collection-prism prism-back"></view>
                <view class="mascot-collection-prism prism-front">
                    <view class="mascot-collection-prism-shine"></view>
                </view>
                <view class="mascot-collection-theme-dot dot-warm"></view>
                <view class="mascot-collection-theme-dot dot-ice"></view>
            </view>
            <view class="mascot-collection-spark spark-top" wx:if="{{!mascotThemeHasNew}}"></view>
            <view class="mascot-collection-spark spark-side"></view>
            <view aria-hidden="true" class="mascot-collection-unread-dot" wx:if="{{mascotThemeHasNew}}"></view>
        </view>
        <text aria-hidden="{{mascotLaunchGuideVisible}}" class="custom-nav-title {{mascotLaunchGuideVisible?'is-guide-covered':''}}">i播播了么</text>
        <mascot-launch-guide bindopen="openMascotSkinSheet" bindvisibilitychange="onMascotLaunchGuideVisibility" blocked="{{homePopupVisible||favoritePickerVisible||customServiceDialogVisible||favoriteAnchorRequestDialogVisible||favoriteRechargeVisible||zapPanelMounted||themeTransitionVisible}}" enabled="{{mascotLaunchGuideEnabled}}" lite="{{performanceClass!==''}}" opened="{{mascotSkinSheetVisible}}" owned="{{favoriteMascotOwned}}" text="{{mascotLaunchGuideText}}" theme="{{mascotThemeClass}}"></mascot-launch-guide>
    </view>
    <view class="content">
        <view class="hero-row">
            <view class="hero-copy">
                <text class="eyebrow">LIVE WATCH</text>
                <view class="hero-title">爱播今天<text class="accent">播了么？</text>
                </view>
                <view class="hero-signal-row">
                    <view bindtap="onRefresh" class="radar {{loading?'is-loading':''}}" hover-class="radar-hover">
                        <view class="radar-ring radar-ring-large"></view>
                        <view class="radar-ring radar-ring-small"></view>
                        <view class="radar-core"></view>
                    </view>
                    <view class="hero-signal-copy">
                        <text class="hero-signal-label">24 小时守候</text>
                        <text class="hero-signal-value">开播立即提醒</text>
                    </view>
                </view>
            </view>
            <view aria-label="{{mascotStatusText}}的{{selectedMascotSkinName}}" aria-role="button" bindtap="onMascotTap" class="mascot-stage skin-{{mascotSkinClass}} state-{{mascotState}} {{mascotWaving?'is-waving':''}} {{mascotTransitioning?'is-state-changing':''}} {{zapActive?'is-zapped':''}} {{zapEasterEggClass}}" hover-class="mascot-stage-hover">
                <button aria-label="爱播专属形象和主题定制" catchtap="openCustomServiceDialog" class="custom-service-entry {{mascotBubbleVisible?'is-bubble-visible':''}}" hover-class="custom-service-entry--pressed">
                    <view aria-hidden="true" class="custom-service-entry-mark">✦</view>
                    <text>定制</text>
                </button>
                <view class="mascot-bubble" wx:if="{{mascotBubbleVisible}}">
                    <text>{{mascotBubbleText}}</text>
                    <view class="mascot-bubble-tail"></view>
                </view>
                <view aria-hidden="true" class="mascot-zap-field" wx:if="{{zapActive||zapPulseItems.length}}">
                    <view class="mascot-zap-sky-flash"></view>
                    <view class="mascot-zap-strike">
                        <view class="mascot-zap-strike-glow"></view>
                        <view class="mascot-zap-strike-core"></view>
                        <view class="mascot-zap-strike-hot"></view>
                        <view class="mascot-zap-branch branch-left"></view>
                        <view class="mascot-zap-branch branch-right"></view>
                        <view class="mascot-zap-strike-impact"></view>
                        <view class="mascot-zap-strike-impact impact-secondary"></view>
                    </view>
                    <view class="mascot-zap-ring"></view>
                    <view class="mascot-zap-bolt bolt-left"></view>
                    <view class="mascot-zap-bolt bolt-right"></view>
                    <view class="mascot-zap-particle particle-one"></view>
                    <view class="mascot-zap-particle particle-two"></view>
                    <view class="mascot-zap-particle particle-three"></view>
                    <view class="mascot-zap-egg-burst">
                        <view class="mascot-zap-egg-ring egg-ring-one"></view>
                        <view class="mascot-zap-egg-ring egg-ring-two"></view>
                        <view class="mascot-zap-egg-shard egg-shard-one"></view>
                        <view class="mascot-zap-egg-shard egg-shard-two"></view>
                        <view class="mascot-zap-egg-shard egg-shard-three"></view>
                        <view class="mascot-zap-egg-shard egg-shard-four"></view>
                    </view>
                </view>
                <view aria-hidden="true" class="mascot-zap-combo-layer" wx:if="{{zapActive||zapPulseItems.length}}">
                    <view class="mascot-zap-combo-pulse {{item.variant}}" wx:for="{{zapPulseItems}}" wx:key="id">
                        <view class="mascot-zap-combo-flash"></view>
                        <view class="mascot-zap-combo-strike"></view>
                        <view class="mascot-zap-combo-ring"></view>
                    </view>
                </view>
                <view aria-hidden="true" class="mascot-smoke" wx:if="{{zapActive||zapPulseItems.length}}">
                    <view class="mascot-smoke-wisp wisp-one"></view>
                    <view class="mascot-smoke-wisp wisp-two"></view>
                    <view class="mascot-smoke-wisp wisp-three"></view>
                </view>
                <view aria-label="{{zapPanelVisible?'收起催播面板':'打开催播面板'}}" aria-role="button" catchtap="toggleZapPanel" class="zap-panel-toggle {{zapPanelVisible?'is-open':''}} {{mailboxEntryVisible?'with-mailbox':''}}" hover-class="zap-panel-toggle--pressed" wx:if="{{selectedMascotSkin==='classic'}}">
                    <view class="zap-panel-toggle-halo"></view>
                    <view class="zap-panel-toggle-core">
                        <view class="zap-panel-toggle-bolt"></view>
                    </view>
                </view>
                <view class="mascot-spark mascot-spark-one" wx:if="{{mascotState==='normal'}}"></view>
                <view class="mascot-spark mascot-spark-two" wx:if="{{mascotState==='normal'}}"></view>
                <starlight-mascot active="{{mascotMotionEnabled}}" class="starlight-mascot-host" lite="{{performanceClass==='performance-lite'}}" state="{{mascotState}}" wx:if="{{selectedMascotSkin==='ibo_starlight'}}"></starlight-mascot>
                <view class="mascot-motion" wx:else>
                    <image binderror="onMascotArtworkError" class="mascot-image" mode="aspectFit" src="{{mascotFrame}}"></image>
                    <image binderror="onMascotArtworkError" class="mascot-image mascot-zap-xray-image" mode="aspectFit" src="{{zapXrayFrame}}" wx:if="{{selectedMascotSkin==='classic'&&zapActive}}"></image>
                </view>
                <view class="mascot-floor"></view>
            </view>
        </view>
        <view aria-hidden="{{!zapPanelVisible}}" class="zap-below-panel {{zapPanelVisible?'is-visible':''}}" wx:if="{{selectedMascotSkin==='classic'&&zapPanelMounted}}">
            <view catchtap="onZapPanelTap" class="zap-below-panel-surface {{zapActive?'is-charged':''}} {{zapEasterEggClass}}">
                <view aria-hidden="true" class="zap-panel-scan"></view>
                <view class="zap-count-grid">
                    <view class="zap-count-item">
                        <view class="zap-count-label-row">
                            <text class="zap-count-label">全网催播</text>
                            <text class="zap-count-badge {{zapEasterEggClass?'is-easter-egg':''}}">{{zapEasterEggClass?zapPanelTitle:'互动展示'}}</text>
                        </view>
                        <text class="zap-count-value">{{globalUrgeCountText}}</text>
                    </view>
                    <view class="zap-count-divider"></view>
                    <view class="zap-count-item zap-count-item-mine">
                        <text class="zap-count-label">我的次数</text>
                        <text class="zap-count-value zap-count-value-mine">{{zapTapCountText}}</text>
                    </view>
                    <view class="zap-count-haptics-divider"></view>
                    <view aria-checked="{{zapHapticsEnabled}}" aria-label="催播震动" aria-role="switch" catchtap="toggleZapHaptics" class="zap-haptics-toggle {{zapHapticsEnabled?'is-on':''}}" hover-class="zap-haptics-toggle--pressed">
                        <view aria-hidden="true" class="zap-haptics-icon">
                            <view class="zap-haptics-wave wave-left"></view>
                            <view class="zap-haptics-device"></view>
                            <view class="zap-haptics-wave wave-right"></view>
                        </view>
                        <text class="zap-haptics-label">震动</text>
                        <view aria-hidden="true" class="zap-haptics-switch">
                            <view class="zap-haptics-switch-knob"></view>
                        </view>
                    </view>
                </view>
                <view class="zap-popover-actions">
                    <view aria-label="催播" aria-role="button" catchtap="onZapTap" class="zap-fire-button" hover-class="zap-fire-button--pressed">
                        <view class="zap-fire-bolt"></view>
                        <text>催播</text>
                        <text class="zap-combo-count" wx:if="{{zapComboCount>1}}">×{{zapComboCount}}</text>
                    </view>
                    <button aria-label="分享我的催播次数" class="zap-share-button" data-share-type="zap" hover-class="zap-share-button--pressed" open-type="share">分享</button>
                </view>
            </view>
        </view>
        <view class="mascot-preview-panel" wx:if="{{isLocalDevelopment}}">
            <view class="mascot-preview-heading">
                <view class="mascot-preview-dot"></view>
                <text>形象预览</text>
            </view>
            <view aria-role="tablist" class="mascot-preview-switch">
                <button bindtap="onMascotPreviewChange" class="mascot-preview-option {{mascotPreviewMode==='auto'?'is-active':''}}" data-mode="auto">自动</button>
                <button bindtap="onMascotPreviewChange" class="mascot-preview-option {{mascotPreviewMode==='normal'?'is-active':''}}" data-mode="normal">守候</button>
                <button bindtap="onMascotPreviewChange" class="mascot-preview-option {{mascotPreviewMode==='leave'?'is-active':''}}" data-mode="leave">请假</button>
                <button bindtap="onMascotPreviewChange" class="mascot-preview-option {{mascotPreviewMode==='live'?'is-active':''}}" data-mode="live">开播</button>
            </view>
        </view>
        <view aria-hidden="true" class="mascot-preload">
            <image mode="aspectFit" src="{{item}}" wx:for="{{mascotPreloadFrames}}" wx:key="*this"></image>
        </view>
        <view class="card account-card">
            <view class="card-heading-row">
                <text class="card-kicker">我的爱播</text>
                <view class="status-pill status-{{anchor.displayStatus}}">
                    <view class="status-dot"></view>
                    <text wx:if="{{anchor.displayStatus==='live'}}">开播中</text>
                    <text wx:elif="{{anchor.displayStatus==='leave'}}">请假中</text>
                    <text wx:elif="{{anchor.displayStatus==='offline'}}">未开播</text>
                    <text wx:else>获取中</text>
                </view>
            </view>
            <view class="card-title-row home-favorite-heading">
                <view class="home-favorite-title">
                    <text class="card-title">{{anchor.nickname}}</text>
                    <view class="verified">✓</view>
                </view>
                <button aria-expanded="{{favoritePickerVisible}}" aria-label="切换我的爱播" bindtap="openFavoriteAnchorPicker" class="favorite-anchor-switch" hover-class="favorite-anchor-switch--pressed" hover-start-time="0" hover-stay-time="160">
                    <view class="favorite-anchor-switch-face {{favoritePickerVisible?'is-covered':''}}">
                        <view aria-hidden="true" class="favorite-anchor-switch-shine"></view>
                        <image aria-hidden="true" class="favorite-anchor-switch-icon" mode="aspectFit" src="/assets/icons/arrow-right-left.svg"></image>
                        <text>切换爱播</text>
                    </view>
                </button>
            </view>
            <view class="anchor-main {{isBirthdayCelebration?'has-birthday-crown':''}}">
                <view class="avatar-wrap">
                    <image binderror="onAvatarError" class="avatar-image" mode="aspectFill" src="{{anchor.avatarUrl}}" wx:if="{{anchor.avatarUrl}}"></image>
                    <view class="avatar-fallback" wx:else>
                        <view class="avatar-shine"></view>
                        <text>{{anchor.initial}}</text>
                    </view>
                    <view aria-hidden="true" class="birthday-crown" wx:if="{{isBirthdayCelebration}}">
                        <image class="birthday-crown-image" mode="aspectFit" src="/assets/images/home/xuxu-birthday-crown.png"></image>
                        <view class="birthday-crown-spark spark-left"></view>
                        <view class="birthday-crown-spark spark-right"></view>
                    </view>
                    <view class="platform-badge">抖</view>
                </view>
                <view class="anchor-copy">
                    <text class="anchor-name">{{anchor.nickname}}</text>
                    <text class="anchor-id">主页 · {{anchorDisplayAccount}}</text>
                    <view class="live-status-row" wx:if="{{anchor.displayStatus==='live'}}">
                        <view aria-label="{{anchor.viewerCountAvailable?anchor.viewerCount+'人在线，查看在线趋势':'在线人数连接中，查看在线趋势'}}" aria-role="button" bindtap="openViewerArchive" class="live-audience" data-account="{{anchor.account}}" hover-class="live-audience--pressed" hover-stay-time="90">
                            <view aria-hidden="true" class="live-audience-signal">
                                <view class="live-audience-ring"></view>
                                <view class="live-audience-core"></view>
                            </view>
                            <block wx:if="{{anchor.viewerCountAvailable}}">
                                <text class="live-audience-number">{{anchor.viewerCountDisplay}}</text>
                                <text class="live-audience-label">人在线</text>
                            </block>
                            <view class="live-audience-loading" wx:else>
                                <view class="live-audience-loading-dot dot-one"></view>
                                <view class="live-audience-loading-dot dot-two"></view>
                                <view class="live-audience-loading-dot dot-three"></view>
                            </view>
                            <text aria-hidden="true" class="live-audience-chevron">›</text>
                        </view>
                        <lottery-countdown account="{{anchor.account}}" lite="{{performanceClass!==''}}" room-id="{{anchor.roomId}}" theme="{{mascotThemeClass}}"></lottery-countdown>
                    </view>
                    <text class="leave-copy" wx:if="{{anchor.displayStatus==='leave'}}">{{anchor.leaveCopy}}</text>
                    <text class="offline-copy" wx:if="{{anchor.displayStatus!=='live'&&anchor.displayStatus!=='leave'}}">暂时还没开播，放心交给我盯着</text>
                </view>
            </view>
        </view>
        <view class="card push-card">
            <block wx:if="{{false}}">
                <view aria-role="tablist" class="reminder-tabs reminder-tabs-{{reminderMode}}">
                    <view aria-role="tab" aria-selected="{{reminderMode==='live'}}" bindtap="onReminderModeChange" class="reminder-tab {{reminderMode==='live'?'is-active':''}}" data-mode="live" hover-class="reminder-tab-hover">
                        <view class="reminder-tab-dot live-dot"></view>
                        <text>开播提醒</text>
                        <text class="reminder-tab-count" wx:if="{{reminderMode==='live'}}">{{notifyCount}}</text>
                    </view>
                    <view aria-role="tab" aria-selected="{{reminderMode==='leave'}}" bindtap="onReminderModeChange" class="reminder-tab {{reminderMode==='leave'?'is-active':''}}" data-mode="leave" hover-class="reminder-tab-hover">
                        <view class="reminder-tab-dot leave-dot"></view>
                        <text>请假提醒</text>
                        <text class="reminder-tab-count leave-count" wx:if="{{reminderMode==='leave'&&leaveTemplateReady}}">{{leaveNotifyCount}}</text>
                        <text class="reminder-tab-new" wx:elif="{{reminderMode==='leave'}}">待接入</text>
                    </view>
                    <view aria-role="tab" aria-selected="{{reminderMode==='work'}}" bindtap="onReminderModeChange" class="reminder-tab {{reminderMode==='work'?'is-active':''}}" data-mode="work" hover-class="reminder-tab-hover">
                        <view class="reminder-tab-dot work-dot"></view>
                        <text>作品提醒</text>
                        <text class="reminder-tab-count work-count" wx:if="{{reminderMode==='work'&&workTemplateReady}}">{{workNotifyCount}}</text>
                        <text class="reminder-tab-new work-new" wx:elif="{{reminderMode==='work'}}">待接入</text>
                    </view>
                </view>
                <view class="reminder-panel reminder-panel-live" wx:if="{{reminderMode==='live'}}">
                    <view class="push-heading">
                        <view class="bell-icon {{notificationSuccessMode==='live'?'is-success':''}}">
                            <view class="bell-body"></view>
                            <view class="bell-clapper"></view>
                        </view>
                        <view class="push-copy">
                            <text class="push-title">实时推送提醒</text>
                        </view>
                        <switch bindchange="onTogglePush" checked="{{pushEnabled}}" color="{{selectedMascotTheme==='siwuliu_ice'?'#3f86b2':'#d93a2f'}}"></switch>
                    </view>
                    <view class="notify-counter {{notificationSuccessMode==='live'?'is-success':''}}">
                        <text class="notify-label">剩余开播通知次数（上限200）</text>
                        <view class="notify-number-row">
                            <view class="notify-number-viewport">
                                <view class="notify-number-stack is-rolling" wx:if="{{notificationRollingMode==='live'}}">
                                    <text class="notify-number notify-number-frame">{{notifyPreviousCount}}</text>
                                    <text class="notify-number notify-number-frame">{{notifyCount}}</text>
                                </view>
                                <text class="notify-number notify-number-frame" wx:else>{{notifyCount}}</text>
                            </view>
                        </view>
                    </view>
                    <view class="notice-bar" wx:if="{{notifyCount===0}}">
                        <view class="notice-symbol">!</view>
                        <view class="notice-copy">
                            <text class="notice-title">剩余通知次数不足，请及时补充</text>
                            <text class="notice-subtitle">（由于微信限制，通知次数只能一次一次点击增加）</text>
                        </view>
                        <text class="notice-arrow">›</text>
                    </view>
                </view>
                <view class="reminder-panel reminder-panel-leave" wx:elif="{{reminderMode==='leave'}}">
                    <view class="push-heading">
                        <view class="leave-icon {{notificationSuccessMode==='leave'?'is-success':''}}">
                            <view class="leave-sheet">
                                <view class="leave-sheet-line leave-sheet-line-long"></view>
                                <view class="leave-sheet-line"></view>
                            </view>
                            <view class="leave-signal"></view>
                        </view>
                        <view class="push-copy">
                            <text class="push-title">实时请假提醒</text>
                            <text class="push-subtitle">宝哥请假随时通知你</text>
                        </view>
                        <switch bindchange="onToggleLeavePush" checked="{{leavePushEnabled}}" color="{{selectedMascotTheme==='siwuliu_ice'?'#6673b5':'#d68122'}}" disabled="{{!leaveTemplateReady}}"></switch>
                    </view>
                    <view class="notify-counter {{notificationSuccessMode==='leave'?'is-success':''}}">
                        <text class="notify-label">剩余请假通知次数（上限200）</text>
                        <view class="notify-number-row">
                            <view class="notify-number-viewport">
                                <view class="notify-number-stack is-rolling" wx:if="{{leaveTemplateReady&&notificationRollingMode==='leave'}}">
                                    <text class="notify-number notify-number-frame leave-notify-number">{{leaveNotifyPreviousCount}}</text>
                                    <text class="notify-number notify-number-frame leave-notify-number">{{leaveNotifyCount}}</text>
                                </view>
                                <text class="notify-number notify-number-frame leave-notify-number" wx:else>{{leaveTemplateReady?leaveNotifyCount:'--'}}</text>
                            </view>
                        </view>
                    </view>
                    <view class="notice-bar leave-setup-bar" wx:if="{{!leaveTemplateReady}}">
                        <view class="notice-symbol leave-notice-symbol">i</view>
                        <view class="notice-copy">
                            <text class="notice-title">请假通知模板待接入</text>
                            <text class="notice-subtitle">模板配置完成后，即可单独授权和累计次数</text>
                        </view>
                    </view>
                </view>
                <view class="reminder-panel reminder-panel-work" wx:else>
                    <view class="push-heading">
                        <view class="work-icon {{notificationSuccessMode==='work'?'is-success':''}}">
                            <view class="work-play"></view>
                            <view class="work-wave wave-one"></view>
                            <view class="work-wave wave-two"></view>
                        </view>
                        <view class="push-copy">
                            <text class="push-title">实时作品提醒</text>
                            <text class="push-subtitle">宝哥更新作品后及时告诉你</text>
                        </view>
                        <switch bindchange="onToggleWorkPush" checked="{{workPushEnabled}}" color="#238b82" disabled="{{!workTemplateReady}}"></switch>
                    </view>
                    <view class="notify-counter {{notificationSuccessMode==='work'?'is-success':''}}">
                        <text class="notify-label">剩余作品通知次数（上限200）</text>
                        <view class="notify-number-row">
                            <view class="notify-number-viewport">
                                <view class="notify-number-stack is-rolling" wx:if="{{workTemplateReady&&notificationRollingMode==='work'}}">
                                    <text class="notify-number notify-number-frame work-notify-number">{{workNotifyPreviousCount}}</text>
                                    <text class="notify-number notify-number-frame work-notify-number">{{workNotifyCount}}</text>
                                </view>
                                <text class="notify-number notify-number-frame work-notify-number" wx:else>{{workTemplateReady?workNotifyCount:'--'}}</text>
                            </view>
                        </view>
                    </view>
                    <view class="notice-bar work-setup-bar" wx:if="{{!workTemplateReady}}">
                        <view class="notice-symbol work-notice-symbol">i</view>
                        <view class="notice-copy">
                            <text class="notice-title">作品通知模板待接入</text>
                            <text class="notice-subtitle">模板配置完成后，即可单独授权和累计次数</text>
                        </view>
                    </view>
                </view>
            </block>
            <view class="push-heading">
                <view class="bell-icon {{notificationSuccessMode==='shared'?'is-success':''}}">
                    <view class="bell-body"></view>
                    <view class="bell-clapper"></view>
                </view>
                <view class="push-copy">
                    <text class="push-title">实时推送提醒</text>
                </view>
                <switch bindchange="onTogglePush" checked="{{pushEnabled}}" color="{{selectedMascotTheme==='ibo_soft_gold'?'#a08b64':selectedMascotTheme==='siwuliu_ice'?'#3f86b2':'#d93a2f'}}"></switch>
            </view>
            <view class="notify-counter shared-notify-counter {{notificationSuccessMode==='shared'?'is-success':''}}">
