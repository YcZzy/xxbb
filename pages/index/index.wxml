                    <text class="favorite-anchor-request-history" wx:if="{{favoriteAnchorRequested}}">上次已推荐：{{favoriteAnchorRequestedAccount}}</text>
                    <view class="favorite-purchase-actions">
                        <button bindtap="submitFavoriteAnchorRequest" class="favorite-anchor-request-submit" disabled="{{favoriteAnchorRequestSaving||favoritePurchaseBusy}}" hover-class="favorite-anchor-request-submit--pressed" loading="{{favoriteAnchorRequestSaving}}">{{favoriteAnchorRequestSaving?'提交中':'免费推荐'}}</button>
                        <button bindtap="prepareFavoriteAnchorPurchase" class="favorite-purchase-instant" disabled="{{favoritePurchaseBusy||favoritePurchaseLoading||favoriteAnchorRequestSaving}}" hover-class="favorite-anchor-request-submit--pressed" loading="{{favoritePurchaseBusy||favoritePurchaseLoading}}">
                            <text class="favorite-purchase-label">立刻加上！</text>
                        </button>
                    </view>
                    <text class="favorite-purchase-hint">立即添加为 i币付费服务</text>
                </view>
                <view class="favorite-purchase-stage favorite-purchase-searching" wx:elif="{{favoritePurchaseStage==='lookup'}}">
                    <view aria-hidden="true" class="favorite-purchase-loader"></view>
                    <text class="favorite-purchase-stage-title">查找中</text>
                    <text class="favorite-purchase-account">@{{favoriteAnchorRequestAccount}}</text>
                    <button bindtap="resetFavoriteAnchorPurchase" class="favorite-purchase-back">返回修改</button>
                </view>
                <view class="favorite-purchase-stage favorite-checkout" wx:elif="{{favoritePurchaseStage==='review'||favoritePurchaseOrder}}">
                    <view class="favorite-purchase-profile" wx:if="{{!favoritePurchaseStandalone}}">
                        <image binderror="onFavoritePurchaseAvatarError" class="favorite-purchase-avatar" mode="aspectFill" src="{{favoritePurchaseProfile.avatar_url}}" wx:if="{{favoritePurchaseProfile.avatar_url}}"></image>
                        <view class="favorite-purchase-avatar favorite-purchase-avatar-placeholder" wx:else>{{favoritePurchaseProfile.initial}}</view>
                        <view class="favorite-purchase-identity">
                            <text class="favorite-purchase-name">{{favoritePurchaseProfile.nickname}}</text>
                            <text class="favorite-purchase-account" user-select="true">@{{favoritePurchaseProfile.account}}</text>
                        </view>
                        <button aria-label="更换主播" bindtap="resetFavoriteAnchorPurchase" class="favorite-checkout-edit" disabled="{{favoritePurchaseBusy}}" wx:if="{{!favoritePurchaseOrder}}">更换</button>
                    </view>
                    <view class="mascot-purchase-intro" wx:if="{{favoritePurchaseStandalone}}">
                        <image binderror="onInlineArtworkError" bindload="loadInlineArtwork" class="mascot-purchase-art" data-art="starlightWait" mode="aspectFit" src="{{inlineArt.starlightWait||'/assets/images/remote-fallback/starlightWait.png'}}"></image>
                        <text class="mascot-purchase-name">播播·星光信使</text>
                        <text class="mascot-purchase-caption">{{favoriteMascotThemeGift?'原创动态形象 · 赠鎏金主题':'原创动态形象 · 永久拥有'}}</text>
                    </view>
                    <block wx:if="{{(!favoritePurchaseOrder||favoritePurchaseOrder.status==='prepared')&&!(favoritePurchaseStandalone&&favoriteMascotOwned)}}">
                        <view class="favorite-checkout-free" wx:if="{{favoritePurchaseProfile.already_monitored}}">
                            <text class="favorite-purchase-stage-title">你已可守候</text>
                        </view>
                        <view class="favorite-checkout-product" wx:else>
                            <image binderror="onInlineArtworkError" bindload="loadInlineArtwork" class="favorite-checkout-art" data-art="starlightWait" mode="aspectFit" src="{{inlineArt.starlightWait||'/assets/images/remote-fallback/starlightWait.png'}}" wx:if="{{!favoritePurchaseStandalone&&(favoritePurchaseKind==='mascot'||favoritePurchaseKind==='benefit')}}"></image>
                            <view class="favorite-checkout-product-copy">
                                <text class="favorite-checkout-product-name">{{favoritePurchaseStandalone?favoriteMascotThemeGift?'形象 + 鎏金主题':'形象 + 1 次添加赋能':favoritePurchaseKind==='mascot'?'i播播了么吉祥物':favoritePurchaseKind==='benefit'?'专属添加权益':'专属守候这位爱播'}}</text>
                                <text class="favorite-checkout-gift" wx:if="{{!favoritePurchaseStandalone&&favoritePurchaseKind==='mascot'&&favoriteMascotThemeGift}}">赠鎏金主题 · 永久解锁</text>
                                <text class="favorite-checkout-gift" wx:if="{{favoritePurchaseKind!=='anchor'}}">{{favoritePurchaseKind==='mascot'?'赠免费添加':'免费添加权益'}}<text class="favorite-checkout-limit"> · 每人限 1 次</text>
                                </text>
                                <view class="favorite-checkout-price" wx:if="{{favoritePurchasePrice>0}}">
                                    <view class="favorite-checkout-current-price">
                                        <text class="favorite-purchase-amount">{{favoritePurchasePrice}}</text>
                                        <text class="favorite-purchase-unit">i币</text>
                                    </view>
                                    <view class="favorite-checkout-compare" wx:if="{{favoritePurchaseKind==='mascot'}}">
                                        <text>单独添加</text>
                                        <text class="favorite-checkout-strike">2999 i币</text>
                                    </view>
                                    <view class="favorite-checkout-compare" wx:elif="{{favoritePurchaseDiscounted}}">
                                        <text>主题九折</text>
                                        <text class="favorite-checkout-strike">2999 i币</text>
                                    </view>
                                </view>
                            </view>
                        </view>
                    </block>
                    <view class="favorite-checkout-complete" wx:elif="{{favoritePurchaseStandalone&&favoriteMascotOwned&&!favoritePurchaseOrder||favoritePurchaseOrder.status==='delivered'||favoritePurchaseOrder.status==='already_exists'}}">
                        <view aria-hidden="true" class="favorite-checkout-checkmark"></view>
                        <text class="favorite-purchase-stage-title">{{favoritePurchaseStandalone||favoritePurchaseOrder.purchase_kind==='mascot'?'吉祥物已解锁':'已加入守候'}}</text>
                    </view>
                    <view class="mascot-purchase-benefit" wx:if="{{favoritePurchaseStandalone}}">
                        <text>{{favoritePurchaseBenefit&&favoritePurchaseBenefit.used?'赋能已使用，形象永久保留':favoritePurchaseBenefit&&favoritePurchaseBenefit.available?'1 次免费添加赋能可用':favoriteMascotOwned?'当前无可用添加赋能':'购买赠 1 次免费添加爱播'}}</text>
                        <text wx:if="{{!(favoritePurchaseBenefit&&favoritePurchaseBenefit.used)&&(!favoriteMascotOwned||favoritePurchaseBenefit&&favoritePurchaseBenefit.available)}}">购买时无需抖音号，稍后确认添加才消耗</text>
                    </view>
                    <text class="favorite-checkout-credit-note" wx:if="{{favoritePurchasePlan&&favoritePurchaseBalance>0&&!favoritePurchaseRechargePending&&!favoritePurchaseProfile.already_monitored&&(!favoritePurchaseOrder||favoritePurchaseOrder.status==='prepared')}}">已有 {{favoritePurchaseBalanceText}} i币，再充 {{favoritePurchasePlan.coins}} i币</text>
                    <button bindtap="submitFavoritePurchase" class="favorite-purchase-instant favorite-purchase-confirm" disabled="{{favoritePurchaseBusy||favoritePurchaseLoading}}" hover-class="favorite-anchor-request-submit--pressed" loading="{{favoritePurchaseBusy}}">{{favoritePurchaseBusy?'处理中，请稍候':favoritePurchasePrimary}}</button>
                    <button bindtap="useStandaloneMascotBenefit" class="mascot-use-benefit" disabled="{{favoritePurchaseBusy||favoritePurchaseLoading}}" wx:if="{{favoritePurchaseStandalone&&favoritePurchaseBenefit&&favoritePurchaseBenefit.available&&(!favoritePurchaseOrder||favoritePurchaseOrder.status==='delivered')}}">使用赋能 · 免费添加爱播</button>
                    <view class="favorite-checkout-footer">
                        <button bindtap="resetFavoriteAnchorPurchase" class="favorite-purchase-back" disabled="{{favoritePurchaseBusy}}" wx:if="{{favoritePurchaseOrder&&favoritePurchaseOrder.can_cancel}}">取消购买</button>
                        <button aria-expanded="{{favoritePurchaseDetails}}" bindtap="toggleFavoritePurchaseDetails" class="favorite-purchase-back favorite-checkout-disclosure">
                            <text>{{favoritePurchaseDetails?'收起明细':'明细与方案'}}</text>
                            <view aria-hidden="true" class="favorite-checkout-chevron {{favoritePurchaseDetails?'is-open':''}}"></view>
                        </button>
                    </view>
                    <view class="favorite-checkout-details" wx:if="{{favoritePurchaseDetails}}">
                        <block wx:if="{{!favoritePurchaseProfile.already_monitored&&(!favoritePurchaseOrder||favoritePurchaseOrder.status==='prepared')}}">
                            <radio-group bindchange="chooseFavoritePurchase" class="favorite-checkout-choices" wx:if="{{!favoritePurchaseStandalone&&favoritePurchasePromotion&&!favoritePurchaseOrder&&favoritePurchaseKind!=='benefit'}}">
                                <label>
                                    <radio checked="{{favoritePurchaseKind==='mascot'}}" color="{{mascotThemeClass==='siwuliu-ice'?'#278bbb':mascotThemeClass==='xiaoyu-moon-tide'?'#208c80':'#bf352e'}}" disabled="{{favoritePurchaseBusy}}" value="mascot"></radio>
                                    <text>吉祥物 + 赠送权益 · 998 i币</text>
                                </label>
                                <label>
                                    <radio checked="{{favoritePurchaseKind==='anchor'}}" color="{{mascotThemeClass==='siwuliu-ice'?'#278bbb':mascotThemeClass==='xiaoyu-moon-tide'?'#208c80':'#bf352e'}}" disabled="{{favoritePurchaseBusy}}" value="anchor"></radio>
                                    <text>单独添加 · {{favoriteAnchorPrice}} i币</text>
                                </label>
                            </radio-group>
                            <view class="favorite-checkout-wallet" wx:if="{{favoritePurchasePrice>0}}">
                                <view class="favorite-checkout-row">
                                    <text>钱包余额</text>
                                    <text>{{favoritePurchaseBalanceText}} i币</text>
                                </view>
                                <view class="favorite-checkout-row favorite-checkout-shortage" wx:if="{{favoritePurchaseShortage>0}}">
                                    <text>还差</text>
                                    <text>{{favoritePurchaseShortage}} i币</text>
                                </view>
                                <view class="favorite-checkout-row" wx:if="{{favoritePurchaseRechargePending}}">
                                    <text>原充值订单</text>
                                    <text>¥{{favoritePurchaseRechargeAmountText}}</text>
                                </view>
                                <block wx:if="{{favoritePurchasePlan&&!favoritePurchaseRechargePending}}">
                                    <view class="favorite-checkout-row favorite-checkout-pay">
                                        <text>本次充值</text>
                                        <text>¥{{favoritePurchasePlan.yuan}}</text>
                                    </view>
                                    <text class="favorite-checkout-remainder">充值 {{favoritePurchasePlan.coins}} i币，购买后余 {{favoritePurchasePlan.remaining}} i币</text>
                                </block>
                            </view>
                        </block>
                        <text wx:if="{{favoritePurchaseKind==='mascot'&&favoritePurchaseEndText}}">{{favoritePurchaseEndText}}</text>
                        <text wx:if="{{favoritePurchaseKind==='mascot'&&favoriteMascotThemeGift}}">购买后永久解锁鎏金主题，可在主题收藏中切换。</text>
                        <text wx:if="{{favoritePurchaseKind==='mascot'||favoritePurchaseKind==='benefit'}}">免费添加爱播每人限 1 次，使用主题不消耗这次权益。</text>
                        <text user-select="true" wx:if="{{favoritePurchaseOrder&&favoritePurchaseOrder.order_id}}">订单 {{favoritePurchaseOrder.order_id}}</text>
                    </view>
                </view>
                <text aria-live="polite" class="favorite-purchase-message" wx:if="{{favoritePurchaseMessage}}">{{favoritePurchaseMessage}}</text>
            </view>
        </view>
    </root-portal>
    <root-portal wx:if="{{homePopupVisible&&homePopup}}">
        <view bindtap="closeHomePopup" catchtouchmove="onHomePopupTouchMove" class="home-campaign-overlay">
            <view catchtap="onHomePopupContentTap" class="home-campaign-modal theme-{{homePopup.themeClass}}">
                <view aria-hidden="true" class="home-campaign-ambient">
                    <view class="home-campaign-orbit orbit-one"></view>
                    <view class="home-campaign-orbit orbit-two"></view>
                    <view class="home-campaign-spark spark-one">✦</view>
                    <view class="home-campaign-spark spark-two">✦</view>
                    <view class="home-campaign-spark spark-three">✦</view>
                </view>
                <button aria-label="关闭" bindtap="closeHomePopup" class="home-campaign-close">×</button>
                <view aria-hidden="true" class="home-campaign-emblem">
                    <view class="home-campaign-emblem-ring"></view>
                    <view class="home-campaign-heart">{{homePopup.iconText}}</view>
                </view>
                <text class="home-campaign-kicker">{{homePopup.kicker}}</text>
                <text class="home-campaign-title">{{homePopup.title}}</text>
                <text class="home-campaign-content">{{homePopup.content}}</text>
                <button bindtap="handleHomePopupAction" class="home-campaign-primary" hover-class="home-campaign-primary--pressed" wx:if="{{homePopup.buttonEnabled}}">
                    <view aria-hidden="true" class="home-campaign-primary-shine"></view>
                    <text>{{homePopup.buttonText}}</text>
                    <text class="home-campaign-primary-arrow">›</text>
                </button>
                <button bindtap="closeHomePopup" class="home-campaign-later" hover-class="home-campaign-later--pressed">稍后再说</button>
            </view>
        </view>
    </root-portal>
</view>
<wallet-recharge bindclose="closeFavoriteRecharge" binddelivered="favoriteRechargeDelivered" lite="{{performanceClass==='performance-lite'}}" recovery-id="{{favoritePurchaseOrder.order_id||''}}" required-coins="{{favoritePurchasePrice}}" skin="{{selectedMascotTheme}}" visible="{{favoriteRechargeVisible&&favoriteAnchorRequestDialogVisible}}"></wallet-recharge>
