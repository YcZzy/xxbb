page {
  background: #e9e6df;
  height: 100%;
}

.digest-page {
  --ink: #1e2528;
  --muted: #74716b;
  --paper: #fffef8;
  --accent: #ae2729;
  --accent-deep: #79191c;
  --jade: #1d665c;
  background:
    linear-gradient(145deg, rgba(36, 89, 82, 0.08), transparent 36%),
    linear-gradient(180deg, #f1eee8, #e5e1da);
  color: var(--ink);
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
}

.digest-page.theme-siwuliu-ice {
  --accent: #356b8b;
  --accent-deep: #264c69;
  --jade: #655c96;
}

.digest-page.theme-xiaoyu-moon-tide {
  --accent: #16869a;
  --accent-deep: #12566c;
  --jade: #9b6a2e;
}

.digest-page.performance-lite {
  background: #e8e5de;
}

.digest-page.performance-lite .paper-grain {
  display: none;
}

.digest-page.performance-lite .newspaper {
  box-shadow: 0 8rpx 24rpx rgba(42, 47, 47, 0.09);
}

.digest-page.performance-lite .resting-avatar {
  filter: none;
}

.custom-nav {
  align-items: center;
  background: hsla(43, 33%, 96%, 0.96);
  border-bottom: 1rpx solid rgba(30, 37, 40, 0.08);
  box-sizing: border-box;
  display: flex;
  flex: none;
  justify-content: center;
  position: relative;
  z-index: 20;
}

.custom-nav-title {
  font-family: serif;
  font-size: 32rpx;
  font-weight: 800;
}

.nav-icon {
  align-items: center;
  background: hsla(0, 0%, 100%, 0.76);
  border: 1rpx solid rgba(30, 37, 40, 0.12);
  border-radius: 50%;
  bottom: 10rpx;
  color: var(--ink);
  display: flex;
  font-size: 34rpx;
  height: 64rpx;
  justify-content: center;
  line-height: 1;
  margin: 0;
  padding: 0;
  position: absolute;
  transition: transform 0.14s ease;
  transition:
    transform 0.14s ease,
    -webkit-transform 0.14s ease;
  width: 64rpx;
}

.approval-trigger::after,
.digest-state button::after,
.history-date-row::after,
.nav-history::after,
.nav-icon::after,
.share-card-actions button::after,
.share-card-close::after,
.share-card-trigger::after {
  border: 0;
}

.nav-history {
  align-items: center;
  background: hsla(0, 0%, 100%, 0.72);
  border: 1rpx solid rgba(30, 37, 40, 0.12);
  border-radius: 8rpx;
  bottom: 13rpx;
  color: var(--ink);
  display: flex;
  font-size: 22rpx;
  font-weight: 750;
  gap: 9rpx;
  height: 58rpx;
  left: 22rpx;
  line-height: 1;
  margin: 0;
  padding: 0 14rpx 0 11rpx;
  position: absolute;
  transition:
    background-color 0.14s ease,
    -webkit-transform 0.14s ease;
  transition:
    transform 0.14s ease,
    background-color 0.14s ease;
  transition:
    transform 0.14s ease,
    background-color 0.14s ease,
    -webkit-transform 0.14s ease;
}

.nav-history--pressed {
  background: hsla(0, 0%, 100%, 0.96);
  transform: scale(0.94);
}

.history-calendar-icon {
  border: 2rpx solid;
  border-radius: 4rpx;
  box-sizing: border-box;
  height: 27rpx;
  position: relative;
  width: 27rpx;
}

.history-calendar-top {
  background: currentColor;
  height: 2rpx;
  left: 0;
  opacity: 0.7;
  position: absolute;
  right: 0;
  top: 6rpx;
}

.history-calendar-dot {
  background: var(--accent);
  border-radius: 50%;
  height: 4rpx;
  position: absolute;
  top: 13rpx;
  width: 4rpx;
}

.history-calendar-dot.dot-left {
  left: 5rpx;
}

.history-calendar-dot.dot-right {
  right: 5rpx;
}

.nav-share {
  padding-bottom: 7rpx;
  right: 24rpx;
}

.nav-icon--pressed {
  transform: scale(0.9);
}

.digest-scroll {
  flex: 1;
  height: 0;
  width: 100%;
}

.newspaper-wrap {
  padding: 26rpx 20rpx calc(174rpx + env(safe-area-inset-bottom));
}

.newspaper,
.newspaper-wrap {
  box-sizing: border-box;
  width: 100%;
}

.newspaper {
  animation: paper-arrive 0.42s cubic-bezier(0.2, 0.76, 0.24, 1) both;
  background: var(--paper);
  border: 1rpx solid rgba(43, 48, 48, 0.12);
  border-radius: 4rpx;
  box-shadow: 0 22rpx 55rpx rgba(42, 47, 47, 0.13);
  min-height: 900rpx;
  overflow: hidden;
  padding: 34rpx 30rpx 30rpx;
  position: relative;
}

.paper-grain {
  background-image:
    radial-gradient(circle at 15% 18%, rgba(94, 74, 53, 0.055) 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 72% 65%, rgba(94, 74, 53, 0.045) 0 1rpx, transparent 2rpx);
  background-size:
    19rpx 19rpx,
    27rpx 27rpx;
  inset: 0;
  opacity: 0.38;
  pointer-events: none;
  position: absolute;
}

.empty-report,
.lead-story,
.masthead,
.paper-footer,
.paper-section,
.summary-grid {
  position: relative;
  z-index: 1;
}

.masthead {
  text-align: center;
}

.masthead-rule {
  animation: rule-open 0.65s ease 0.1s both;
  border-bottom: 1rpx solid var(--ink);
  border-top: 2rpx solid var(--ink);
  height: 8rpx;
  transform-origin: center;
}

.masthead-title-row {
  align-items: center;
  display: flex;
  gap: 24rpx;
  justify-content: center;
  margin-top: 14rpx;
}

.masthead-title {
  font-family: STKaiti, KaiTi, serif;
  font-size: 72rpx;
  font-weight: 900;
  line-height: 1.12;
}

.masthead-star {
  animation: star-breathe 2.6s ease-in-out infinite;
  color: var(--accent);
  font-size: 24rpx;
}

.masthead-subtitle {
  color: var(--muted);
  display: block;
  font-size: 17rpx;
  font-weight: 700;
  margin-top: 3rpx;
}

.masthead-meta {
  align-items: center;
  border-bottom: 3rpx double rgba(30, 37, 40, 0.7);
  border-top: 1rpx solid rgba(30, 37, 40, 0.58);
  color: #4e504e;
  display: flex;
  font-size: 21rpx;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 9rpx 4rpx;
}

.preview-tag {
  border: 1rpx solid var(--accent);
  color: var(--accent);
  padding: 3rpx 8rpx;
}

.lead-story {
  padding: 30rpx 0 24rpx;
  text-align: center;
}

.lead-kicker {
  background: var(--accent);
  color: #fff;
  display: inline-block;
  font-size: 20rpx;
  font-weight: 800;
  padding: 4rpx 14rpx;
}

.lead-title {
  display: block;
  font-family: STSong, SimSun, serif;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.5;
  margin-top: 18rpx;
}

.followed-cast {
  align-items: center;
  display: flex;
  gap: 18rpx;
  justify-content: center;
  margin: 25rpx auto 0;
  max-width: 590rpx;
  text-align: left;
}

.followed-avatar-stack {
  display: flex;
  flex: none;
  min-width: 0;
  padding-left: 13rpx;
}

.followed-avatar-shell {
  height: 54rpx;
  margin-left: -13rpx;
  width: 54rpx;
}

.followed-avatar {
  border: 3rpx solid var(--paper);
  border-radius: 50%;
  box-shadow: 0 0 0 1rpx rgba(30, 37, 40, 0.22);
  box-sizing: border-box;
  height: 54rpx;
  width: 54rpx;
}

.followed-avatar-fallback {
  align-items: center;
  background: var(--jade);
  color: #fff;
  display: flex;
  font-family: STKaiti, KaiTi, serif;
  font-size: 22rpx;
  font-weight: 900;
  justify-content: center;
}

.followed-cast-copy {
  min-width: 0;
}

.followed-cast-kicker,
.followed-cast-names {
  display: block;
}

.followed-cast-kicker {
  color: var(--accent);
  font-size: 17rpx;
  font-weight: 850;
}

.followed-cast-names {
  color: #55524d;
  font-size: 20rpx;
  margin-top: 4rpx;
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lead-divider {
  align-items: center;
  color: var(--muted);
  display: flex;
  font-size: 18rpx;
  gap: 14rpx;
  margin-top: 22rpx;
}

.lead-divider view {
  background: rgba(30, 37, 40, 0.24);
  flex: 1;
  height: 1rpx;
}

.summary-grid {
  border-bottom: 2rpx solid var(--ink);
  border-top: 2rpx solid var(--ink);
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-bottom: 34rpx;
  overflow: hidden;
}

.summary-cell {
  align-items: center;
  border-bottom: 1rpx solid rgba(30, 37, 40, 0.2);
  border-right: 1rpx solid rgba(30, 37, 40, 0.2);
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 104rpx;
}

.summary-cell:nth-child(3n) {
  border-right: 0;
}

.summary-cell:nth-last-child(-n + 3) {
  border-bottom: 0;
}

.summary-value {
  color: var(--accent-deep);
  font-family: Georgia, STSong, serif;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.15;
  max-width: 100%;
}

.summary-label {
  color: var(--muted);
  font-size: 20rpx;
  margin-top: 9rpx;
}

.paper-section {
  margin-top: 34rpx;
}

.section-heading {
  align-items: center;
  display: flex;
  font-family: STSong, SimSun, serif;
  font-size: 28rpx;
  font-weight: 900;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.section-index {
  color: var(--accent);
  font-family: Georgia, serif;
  font-size: 19rpx;
}

.section-rule {
  background: rgba(30, 37, 40, 0.3);
  flex: 1;
  height: 1rpx;
}

.editor-note {
  background: rgba(29, 102, 92, 0.045);
  border-bottom: 1rpx solid rgba(30, 37, 40, 0.16);
  border-top: 1rpx solid rgba(30, 37, 40, 0.16);
  padding: 18rpx 18rpx 20rpx 46rpx;
  position: relative;
}

.editor-quote {
  color: var(--accent);
  font-family: Georgia, serif;
  font-size: 58rpx;
  left: 12rpx;
  line-height: 1;
  opacity: 0.7;
  position: absolute;
  top: 3rpx;
}

.editor-note-copy {
  color: #494c49;
  font-family: STSong, SimSun, serif;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 1.72;
}

.fun-fact-list {
  border-bottom: 1rpx solid rgba(30, 37, 40, 0.42);
  border-top: 2rpx solid var(--ink);
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 21rpx;
}

.fun-fact-item {
  border-bottom: 1rpx dotted rgba(30, 37, 40, 0.2);
  display: flex;
  gap: 10rpx;
  min-width: 0;
  padding: 18rpx 12rpx 18rpx 0;
}

.fun-fact-item:nth-child(odd) {
  border-right: 1rpx solid rgba(30, 37, 40, 0.18);
}

.fun-fact-item:nth-child(even) {
  padding-left: 15rpx;
}

.fun-fact-item:nth-last-child(-n + 2) {
  border-bottom: 0;
}

.fun-fact-index {
  color: var(--accent);
  font-family: Georgia, serif;
  font-size: 17rpx;
  font-weight: 900;
}

.fun-fact-copy {
  min-width: 0;
}

.fun-fact-detail,
.fun-fact-label,
.fun-fact-value {
  display: block;
}

.fun-fact-label {
  color: var(--muted);
  font-size: 17rpx;
}

.fun-fact-value {
  color: var(--ink);
  font-family: STSong, SimSun, serif;
  font-size: 24rpx;
  font-weight: 900;
}

.fun-fact-detail,
.fun-fact-value {
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fun-fact-detail {
  color: var(--accent-deep);
  font-size: 18rpx;
  font-weight: 750;
}

.anchor-report {
  animation: article-rise 0.42s ease both;
  border-top: 2rpx solid var(--ink);
  padding: 24rpx 0 28rpx;
}

.anchor-report + .anchor-report {
  border-top: 1rpx solid rgba(30, 37, 40, 0.28);
}

.anchor-report-head,
.headline-article {
  align-items: center;
  display: flex;
  gap: 18rpx;
}

.headline-article {
  animation: article-rise 0.42s ease both;
  border-bottom: 1rpx solid rgba(30, 37, 40, 0.16);
  padding: 23rpx 0;
  position: relative;
}

.headline-article:nth-child(3) {
  animation-delay: 80ms;
}

.headline-article:nth-child(4) {
  animation-delay: 0.14s;
}

.article-rank {
  color: rgba(30, 37, 40, 0.07);
  font-family: Georgia, serif;
  font-size: 62rpx;
  font-weight: 900;
  position: absolute;
  right: 2rpx;
  top: 12rpx;
}

.article-avatar-wrap {
  flex: none;
  height: 88rpx;
  position: relative;
  width: 88rpx;
}

.article-avatar {
  border: 3rpx solid var(--paper);
  border-radius: 50%;
  box-shadow:
    0 0 0 2rpx var(--accent),
    0 7rpx 18rpx rgba(25, 35, 35, 0.12);
  box-sizing: border-box;
  height: 88rpx;
  width: 88rpx;
}

.article-avatar-fallback,
.resting-avatar-fallback {
  align-items: center;
  background: linear-gradient(145deg, var(--jade), var(--accent-deep));
  color: #fff;
  display: flex;
  font-family: STKaiti, KaiTi, serif;
  font-size: 34rpx;
  font-weight: 900;
  justify-content: center;
}

.article-copy {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.article-name-row {
  align-items: center;
  display: flex;
  gap: 12rpx;
}

.article-name {
  font-family: STSong, SimSun, serif;
  font-size: 31rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-ribbon {
  background: rgba(29, 102, 92, 0.07);
  border-left: 4rpx solid var(--jade);
  color: var(--jade);
  flex: none;
  font-size: 18rpx;
  font-weight: 800;
  padding: 3rpx 8rpx;
}

.article-headline {
  color: #484b49;
  display: block;
  font-size: 23rpx;
  line-height: 1.45;
  margin-top: 7rpx;
  max-width: 100%;
}

.article-time {
  color: var(--muted);
  display: block;
  font-size: 18rpx;
  margin-top: 9rpx;
}

.session-ribbon {
  background: rgba(29, 102, 92, 0.07);
  border-left: 4rpx solid var(--jade);
  color: var(--jade);
  flex: none;
  font-size: 18rpx;
  font-weight: 800;
  padding: 3rpx 8rpx;
}

.anchor-stat-grid {
  border-bottom: 1rpx solid rgba(30, 37, 40, 0.28);
  border-top: 1rpx solid rgba(30, 37, 40, 0.28);
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 20rpx;
  overflow: hidden;
}

.anchor-stat {
  align-items: center;
  border-bottom: 1rpx solid rgba(30, 37, 40, 0.13);
  border-right: 1rpx solid rgba(30, 37, 40, 0.13);
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 82rpx;
  padding: 7rpx 4rpx;
  text-align: center;
}

.anchor-stat:nth-child(3n) {
  border-right: 0;
}

.anchor-stat-label,
.anchor-stat-value {
  display: block;
  max-width: 100%;
}

.anchor-stat-value {
  color: var(--accent-deep);
  font-family: Georgia, STSong, serif;
  font-size: 23rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.anchor-stat-label {
  color: var(--muted);
  font-size: 16rpx;
  margin-top: 5rpx;
}

.article-dateline {
  color: var(--muted);
  flex-wrap: wrap;
  font-size: 18rpx;
  gap: 7rpx 16rpx;
  margin-top: 12rpx;
}

.article-dateline,
.brief-row {
  display: flex;
}

.brief-row {
  align-items: center;
  border-bottom: 1rpx dotted rgba(30, 37, 40, 0.24);
  gap: 13rpx;
  padding: 18rpx 0;
}

.brief-dot {
  background: var(--accent);
  border-radius: 50%;
  flex: none;
  height: 7rpx;
  width: 7rpx;
}

.brief-copy {
  flex: 1;
  min-width: 0;
}

.brief-name {
  display: block;
  font-size: 25rpx;
  font-weight: 850;
}

.brief-headline {
  color: var(--muted);
  display: block;
  font-size: 20rpx;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.brief-duration {
  color: var(--accent-deep);
  flex: none;
  font-size: 21rpx;
  font-weight: 800;
}

.clip-anchor-block {
  border-top: 2rpx solid var(--ink);
  padding: 22rpx 0 25rpx;
}

.clip-anchor-block + .clip-anchor-block {
  border-top-color: rgba(30, 37, 40, 0.24);
  border-top-width: 1rpx;
}

.clip-anchor-head {
  gap: 14rpx;
}

.clip-anchor-avatar,
.clip-anchor-head {
  align-items: center;
  display: flex;
}

.clip-anchor-avatar {
  border: 2rpx solid var(--paper);
  border-radius: 50%;
  box-shadow: 0 0 0 2rpx var(--jade);
  box-sizing: border-box;
  flex: none;
  height: 58rpx;
  justify-content: center;
  width: 58rpx;
}

.clip-anchor-fallback {
  background: var(--jade);
  color: #fff;
  font-family: STKaiti, KaiTi, serif;
  font-size: 25rpx;
  font-weight: 900;
}

.clip-anchor-copy {
  flex: 1;
  min-width: 0;
}

.clip-anchor-name {
  color: var(--ink);
  display: block;
  font-family: STSong, SimSun, serif;
  font-size: 27rpx;
  font-weight: 900;
}

.clip-anchor-count {
  background: rgba(174, 39, 41, 0.06);
  border-left: 4rpx solid var(--accent);
  color: var(--accent);
  flex: none;
  font-size: 17rpx;
  font-weight: 850;
  padding: 4rpx 8rpx;
}

.clip-topic-list {
  border-left: 1rpx solid rgba(29, 102, 92, 0.32);
  margin: 17rpx 0 0 28rpx;
  position: relative;
}

.clip-topic-row {
  display: flex;
  padding: 0 0 19rpx 22rpx;
  position: relative;
}

.clip-topic-row:last-child {
  padding-bottom: 2rpx;
}

.clip-topic-marker {
  background: var(--jade);
  border: 3rpx solid var(--paper);
  border-radius: 50%;
  box-shadow: 0 0 0 1rpx var(--jade);
  box-sizing: border-box;
  height: 11rpx;
  left: -6rpx;
  position: absolute;
  top: 9rpx;
  width: 11rpx;
}

.clip-topic-copy,
.clip-topic-title {
  flex: 1;
  min-width: 0;
}

.clip-topic-title {
  color: #353a39;
  display: block;
  font-family: STSong, SimSun, serif;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.clip-topic-heading {
  align-items: flex-start;
  display: flex;
  gap: 12rpx;
}

.clip-hot {
  background: var(--accent-deep);
  border-radius: 4rpx;
  color: #fff;
  flex: none;
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 0;
  line-height: 1.5;
  margin-top: 3rpx;
  padding: 2rpx 8rpx;
}

.clip-topic-row--hot .clip-topic-marker {
  background: var(--accent-deep);
  box-shadow: 0 0 0 1rpx var(--accent-deep);
}

.clip-topic-body {
  color: #625b51;
  display: block;
  font-size: 21rpx;
  line-height: 1.65;
  margin-top: 7rpx;
  overflow-wrap: anywhere;
}

.clip-topic-meta {
  color: var(--muted);
  display: flex;
  flex-wrap: wrap;
  font-size: 16rpx;
  gap: 12rpx;
  margin-top: 6rpx;
  overflow-wrap: anywhere;
}

.clip-like-count {
  color: var(--ink);
  font-size: 20rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 700;
}

.clip-like-count--hot {
  color: var(--accent-deep);
}

.clip-topic-meta text + text::before {
  color: rgba(30, 37, 40, 0.3);
  content: '·';
  margin-right: 12rpx;
}

.clip-source-note {
  color: rgba(91, 90, 85, 0.72);
  display: block;
  font-size: 16rpx;
  line-height: 1.55;
  margin-top: 10rpx;
}

.resting-list {
  flex-wrap: wrap;
  gap: 18rpx 24rpx;
}

.resting-list,
.resting-person {
  display: flex;
}

.resting-person {
  align-items: center;
  color: #555853;
  font-size: 22rpx;
