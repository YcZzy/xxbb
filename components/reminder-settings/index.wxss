  align-items: center;
  box-sizing: border-box;
  justify-content: center;
  padding: 42rpx 28rpx calc(42rpx + env(safe-area-inset-bottom));
  z-index: 2300;
}

.time-picker-sheet {
  animation: quiet-dialog-in 0.32s cubic-bezier(0.2, 0.86, 0.28, 1.05) both;
  border: 1rpx solid hsla(0, 0%, 100%, 0.84);
  border-radius: 16rpx;
  box-shadow: 0 30rpx 84rpx rgba(49, 28, 35, 0.26);
  max-height: calc(100vh - 140rpx);
  max-width: 650rpx;
  overflow-y: auto;
  padding: 30rpx 30rpx 34rpx;
  width: 100%;
}

.time-picker-handle {
  display: none;
}

.time-picker-layer.is-closing .time-picker-sheet {
  animation: quiet-dialog-out 0.22s ease both;
}

@-webkit-keyframes quiet-dialog-in {
  from {
    opacity: 0;
    transform: translateY(34rpx) scale(0.96);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes quiet-dialog-in {
  from {
    opacity: 0;
    transform: translateY(34rpx) scale(0.96);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@-webkit-keyframes quiet-dialog-out {
  from {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  to {
    opacity: 0;
    transform: translateY(24rpx) scale(0.97);
  }
}

@keyframes quiet-dialog-out {
  from {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  to {
    opacity: 0;
    transform: translateY(24rpx) scale(0.97);
  }
}

@media (prefers-reduced-motion: reduce) {
  .quiet-panel,
  .time-picker-layer.is-closing .time-picker-sheet,
  .time-picker-sheet {
    animation: none;
  }
}

@-webkit-keyframes reminder-enable {
  0% {
    transform: scale(0.88) rotate(-8deg);
  }

  65% {
    transform: scale(1.1) rotate(3deg);
  }

  100% {
    transform: scale(1) rotate(0);
  }
}

@keyframes reminder-enable {
  0% {
    transform: scale(0.88) rotate(-8deg);
  }

  65% {
    transform: scale(1.1) rotate(3deg);
  }

  100% {
    transform: scale(1) rotate(0);
  }
}

@-webkit-keyframes mic-enable {
  0%,
  100% {
    transform: rotate(0);
  }

  35% {
    transform: rotate(-12deg);
  }

  70% {
    transform: rotate(8deg);
  }
}

@keyframes mic-enable {
  0%,
  100% {
    transform: rotate(0);
  }

  35% {
    transform: rotate(-12deg);
  }

  70% {
    transform: rotate(8deg);
  }
}

.is-paused .notification-tile .linkmic-icon-capsule,
.is-paused .notification-tile .original-setting-image {
  animation: none;
}

.is-paused .notification-tile::after {
  transition: none;
}

@media (prefers-reduced-motion: reduce) {
  .notification-tile.is-on .linkmic-icon-capsule,
  .notification-tile.is-on .original-setting-image {
    animation: none;
  }

  .notification-tile,
  .notification-tile::after,
  .reminder-entry-arrow,
  .reminder-entry-icon {
    transition: none;
  }
}
