<recharge-dialog action-text="{{tipRechargeAction}}" active="{{foreground&&active}}" balance-text="{{balance===null?'--':balance}}" bindamountinput="changeTipRecharge" bindcancel="cancelTipRecharge" bindclose="closeDialog" bindconfirm="confirmTipRecharge" bindcustom="chooseTipRecharge" bindexpire="expireTipRecharge" bindrecords="openRecords" bindselect="chooseTipRecharge" busy="{{busy}}" can-cancel="{{tipRechargeCanCancel}}" coins="{{tipRechargeCoins}}" coins-text="{{tipRechargeCoins===null?'--':tipRechargeCoins}}" custom="{{tipRechargeCustom}}" deadline="{{tipRechargeDeadline}}" input-value="{{tipRechargeInput}}" lite="{{lite}}" locked="{{tipRechargeLocked||tipRechargeDone}}" message="{{message}}" mode="{{tipRechargeMode}}" options="{{tipRechargeOptions}}" order-id="{{tipRechargeOrderId}}" price-text="{{tipRechargeYuan}}" range-text="{{tipRechargeRange}}" ready="{{tipRechargeReady}}" show-records="{{tipRechargeLocked}}" skin="{{skin}}" visible="{{visible&&dialog==='recharge'}}"></recharge-dialog>
