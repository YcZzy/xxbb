  color: #97857b;
  flex: 1;
}

.tip-confirm {
  background: #b94a43;
  color: #fff;
  flex: 2;
}

.tip-panel .tip-confirm[disabled] {
  background: #b94a43;
  color: #fff;
  opacity: 0.72;
}

.tip-panel .tip-cancel[disabled] {
  background: #f0eae5;
  color: #97857b;
  opacity: 0.72;
}

.tip-panel .tip-panel-head button[disabled] {
  background: transparent;
  color: #7e8a7e;
  opacity: 0.72;
}

.tip-panel .tip-records[disabled] {
  background: transparent;
  color: #977c6e;
  opacity: 0.72;
}

.tip-records {
  background: transparent;
  color: #977c6e;
  font-size: 21rpx;
  line-height: 1.5;
  margin: 14rpx auto 0;
  padding: 14rpx 0;
}

.thanking .tip-character {
  animation: tip-bow 1.5s ease both;
}

.is-sending .tip-bubble,
.is-sending .tip-glint::after {
  animation: none;
}

.tip-sending-spinner {
  animation: tip-sending-turn 0.8s linear infinite;
  border: 3rpx solid #fff4e855;
  border-radius: 50%;
  border-top-color: #fff4e8;
  box-sizing: border-box;
  flex: none;
  height: 26rpx;
  margin-right: 12rpx;
  width: 26rpx;
}

.is-lite .tip-atlas,
.is-lite .tip-bubble,
.is-lite .tip-character,
.is-lite .tip-glint::after,
.is-lite .tip-guest,
.is-lite .tip-sending-spinner {
  animation: none;
}

@-webkit-keyframes tip-sending-turn {
  to {
    transform: rotate(1turn);
  }
}

@keyframes tip-sending-turn {
  to {
    transform: rotate(1turn);
  }
}

@-webkit-keyframes tip-arrive {
  0% {
    opacity: 0;
    transform: translate3d(90rpx, 520rpx, 0) scale(0.84);
  }

  12% {
    opacity: 1;
  }

  78% {
    transform: translate3d(8rpx, 22rpx, 0) scale(0.99);
  }

  100% {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }
}

@keyframes tip-arrive {
  0% {
    opacity: 0;
    transform: translate3d(90rpx, 520rpx, 0) scale(0.84);
  }

  12% {
    opacity: 1;
  }

  78% {
    transform: translate3d(8rpx, 22rpx, 0) scale(0.99);
  }

  100% {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }
}

@-webkit-keyframes tip-footfall {
  0%,
  100%,
  50% {
    transform: translateY(0) rotate(0);
  }

  25% {
    transform: translateY(-5rpx) rotate(-1.3deg);
  }

  75% {
    transform: translateY(-5rpx) rotate(1.3deg);
  }
}

@keyframes tip-footfall {
  0%,
  100%,
  50% {
    transform: translateY(0) rotate(0);
  }

  25% {
    transform: translateY(-5rpx) rotate(-1.3deg);
  }

  75% {
    transform: translateY(-5rpx) rotate(1.3deg);
  }
}

@-webkit-keyframes tip-walk-cycle {
  0%,
  100% {
    transform: translateX(0);
  }

  25% {
    transform: translateX(-25%);
  }

  50% {
    transform: translateX(-50%);
  }

  75% {
    transform: translateX(-75%);
  }
}

@keyframes tip-walk-cycle {
  0%,
  100% {
    transform: translateX(0);
  }

  25% {
    transform: translateX(-25%);
  }

  50% {
    transform: translateX(-50%);
  }

  75% {
    transform: translateX(-75%);
  }
}

@-webkit-keyframes tip-speak {
  from {
    opacity: 0;
    transform: translateY(12rpx) scale(0.84);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes tip-speak {
  from {
    opacity: 0;
    transform: translateY(12rpx) scale(0.84);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@-webkit-keyframes tip-edge-glint {
  0% {
    opacity: 0;
    transform: translateX(0);
  }

  25% {
    opacity: 0.85;
  }

  100% {
    opacity: 0;
    transform: translateX(340%);
  }
}

@keyframes tip-edge-glint {
  0% {
    opacity: 0;
    transform: translateX(0);
  }

  25% {
    opacity: 0.85;
  }

  100% {
    opacity: 0;
    transform: translateX(340%);
  }
}

@-webkit-keyframes tip-leave {
  from {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  to {
    opacity: 0;
    transform: translate3d(220rpx, 220rpx, 0) scale(0.88);
  }
}

@keyframes tip-leave {
  from {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  to {
    opacity: 0;
    transform: translate3d(220rpx, 220rpx, 0) scale(0.88);
  }
}

@-webkit-keyframes tip-bow {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(8rpx);
  }
}

@keyframes tip-bow {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(8rpx);
  }
}

@media (max-height: 520px) {
  .tip-guest {
    bottom: calc(130rpx + env(safe-area-inset-bottom));
    height: 200rpx;
    width: 200rpx;
  }

  .tip-bubble {
    bottom: calc(350rpx + env(safe-area-inset-bottom));
    padding-bottom: 22rpx;
    padding-top: 24rpx;
  }

  .tip-bubble-body {
    max-height: calc(100vh - 430rpx - env(safe-area-inset-bottom));
  }
}

@media (prefers-reduced-motion: reduce) {
  .tip-atlas,
  .tip-bubble,
  .tip-character,
  .tip-glint::after,
  .tip-guest,
  .tip-sending-spinner {
    animation: none;
  }

  .tip-dismiss {
    transition: none;
  }
}

.tip-discount {
  color: #e0c797;
  display: block;
  font-size: 22rpx;
  line-height: 1.5;
  margin-top: 12rpx;
}

.theme-ibo-soft-gold .tip-discount {
  color: #665427;
}
