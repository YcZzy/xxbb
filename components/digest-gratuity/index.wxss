  margin: 14rpx 0 24rpx;
  text-align: center;
}

.tip-disclosure {
  color: #7e8376;
  line-height: 1.8;
  margin: 24rpx 0;
}

.tip-disclosure,
.tip-message {
  display: block;
  font-size: 22rpx;
}

.tip-message {
  color: #a74945;
  line-height: 1.7;
  margin: 12rpx 0;
  word-break: break-all;
}

.tip-bubble .tip-message {
