.starlight-mascot {
  height: 100%;
  position: relative;
  transform: scale(1);
  transition: transform 0.16s ease;
  transition:
    transform 0.16s ease,
    -webkit-transform 0.16s ease;
  width: 100%;
}

.starlight-mascot.is-pressed {
  transform: scale(0.97);
}

.starlight-art,
.starlight-float,
.starlight-pose {
  height: 100%;
  left: 0;
  position: absolute;
  top: 0;
  width: 100%;
}

.starlight-pose {
  opacity: 0;
  pointer-events: none;
  transform: translateY(6rpx) scale(0.96);
  transition:
    opacity 0.38s ease,
    -webkit-transform 0.52s cubic-bezier(0.2, 0.8, 0.2, 1);
  transition:
    opacity 0.38s ease,
    transform 0.52s cubic-bezier(0.2, 0.8, 0.2, 1);
  transition:
    opacity 0.38s ease,
    transform 0.52s cubic-bezier(0.2, 0.8, 0.2, 1),
    -webkit-transform 0.52s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.state-leave .pose-wait,
.state-live .pose-live,
.state-normal .pose-wait {
  opacity: 1;
  transform: translateY(0) scale(1);
}

.starlight-float {
  animation: starlight-watch-float 5.6s ease-in-out infinite;
  transform-origin: 50% 60%;
}

.pose-live .starlight-float {
  animation: starlight-game-float 2.8s ease-in-out infinite;
}

.starlight-shadow {
  animation: starlight-shadow-breathe 5.6s ease-in-out infinite;
  background: rgba(177, 131, 84, 0.09);
  border-radius: 50%;
  bottom: 0;
  height: 3%;
  left: 30%;
  position: absolute;
  width: 40%;
}

.state-live .starlight-shadow {
  animation-duration: 2.8s;
}

.starlight-beacon {
  animation: starlight-beacon-breathe 3.8s ease-in-out infinite;
  height: 8%;
  left: 58.5%;
  position: absolute;
  top: 57.5%;
  width: 8%;
}

.pose-live .starlight-beacon {
  animation-duration: 1.8s;
  height: 7%;
  left: 41%;
  top: 57%;
  width: 7%;
}

.starlight-glint,
.starlight-spark {
  height: 100%;
  position: absolute;
  width: 100%;
}

.starlight-glint::after,
.starlight-glint::before,
.starlight-spark::after,
.starlight-spark::before {
  background: linear-gradient(
    90deg,
    transparent,
    #fff0b9 35%,
    #fffdf1 50%,
    #ffda92 65%,
    transparent
  );
  border-radius: 50%;
  content: '';
  height: 12%;
  left: 0;
  position: absolute;
  top: 44%;
  width: 100%;
}

.starlight-glint::after,
.starlight-spark::after {
  transform: rotate(90deg);
}

.starlight-spark {
  animation: starlight-twinkle 3.6s ease-in-out infinite;
  height: 5%;
  width: 5%;
}

.spark-one {
  animation-delay: -0.8s;
  left: 19%;
  top: 71%;
}

.spark-two {
  animation-delay: -2.2s;
  left: 82%;
  top: 46%;
}

.spark-three {
  animation-delay: -1.5s;
  left: 72%;
  top: 85%;
}

.pose-live .spark-one {
  left: 17%;
  top: 51%;
}

.pose-live .spark-two {
  left: 75%;
  top: 27%;
}

.starlight-orbit {
  height: 90%;
  left: 5%;
  pointer-events: none;
  position: absolute;
  top: 25%;
  transform: rotate(-25deg) scaleY(0.42);
  width: 90%;
}

.starlight-orbit-turn {
  animation: starlight-orbit-flow 9s linear infinite;
  height: 100%;
  width: 100%;
}

.starlight-traveller {
  background: #fff8e5;
  border-radius: 50%;
  box-shadow: 0 0 4rpx 2rpx rgba(113, 210, 237, 0.55);
  height: 5rpx;
  left: 0;
  position: absolute;
  top: 50%;
  transform: scaleY(2.38);
  width: 5rpx;
}

.pose-live .starlight-orbit {
  height: 78%;
  left: 13%;
  top: 27%;
  transform: rotate(-38deg) scaleY(0.6);
  width: 78%;
}

.pose-live .starlight-orbit-turn {
  animation-duration: 4s;
}

.pose-live .starlight-traveller {
  box-shadow: 0 0 5rpx 2rpx rgba(240, 168, 71, 0.6);
  transform: scaleY(1.67);
}

.starlight-signal {
  animation: starlight-signal-send 2.2s ease-out infinite;
  border: 2rpx solid transparent;
  border-radius: 50%;
  border-top-color: rgba(83, 194, 224, 0.9);
  box-sizing: border-box;
  height: 9%;
  left: 32%;
  position: absolute;
  top: 53%;
  transform-origin: 50% 100%;
  width: 11%;
}

.signal-two {
  animation-delay: -1.1s;
}

@-webkit-keyframes starlight-watch-float {
  0%,
  100% {
    transform: translateY(2rpx) rotate(-0.6deg);
  }

  50% {
    transform: translateY(-6rpx) rotate(0.6deg);
  }
}

@keyframes starlight-watch-float {
  0%,
  100% {
    transform: translateY(2rpx) rotate(-0.6deg);
  }

  50% {
    transform: translateY(-6rpx) rotate(0.6deg);
  }
}

@-webkit-keyframes starlight-game-float {
  0%,
  100% {
    transform: translateY(1rpx) rotate(-0.6deg);
  }

  45% {
    transform: translateY(-5rpx) rotate(0.7deg);
  }

  70% {
    transform: translateY(-2rpx) rotate(0deg);
  }
}

@keyframes starlight-game-float {
  0%,
  100% {
    transform: translateY(1rpx) rotate(-0.6deg);
  }

  45% {
    transform: translateY(-5rpx) rotate(0.7deg);
  }

  70% {
    transform: translateY(-2rpx) rotate(0deg);
  }
}

@-webkit-keyframes starlight-shadow-breathe {
  0%,
  100% {
    opacity: 0.8;
    transform: scaleX(1);
  }

  50% {
    opacity: 0.45;
    transform: scaleX(0.85);
  }
}

@keyframes starlight-shadow-breathe {
  0%,
  100% {
    opacity: 0.8;
    transform: scaleX(1);
  }

  50% {
    opacity: 0.45;
    transform: scaleX(0.85);
  }
}

@-webkit-keyframes starlight-beacon-breathe {
  0%,
  100% {
    opacity: 0.25;
    transform: scale(0.65) rotate(-8deg);
  }

  50% {
    opacity: 0.95;
    transform: scale(1.15) rotate(8deg);
  }
}

@keyframes starlight-beacon-breathe {
  0%,
  100% {
    opacity: 0.25;
    transform: scale(0.65) rotate(-8deg);
  }

  50% {
    opacity: 0.95;
    transform: scale(1.15) rotate(8deg);
  }
}

@-webkit-keyframes starlight-twinkle {
  0%,
  100% {
    opacity: 0.1;
    transform: scale(0.5) rotate(0deg);
  }

  45% {
    opacity: 0.85;
    transform: scale(1) rotate(30deg);
  }

  75% {
    opacity: 0.25;
    transform: scale(0.65) rotate(55deg);
  }
}

@keyframes starlight-twinkle {
  0%,
  100% {
    opacity: 0.1;
    transform: scale(0.5) rotate(0deg);
  }

  45% {
    opacity: 0.85;
    transform: scale(1) rotate(30deg);
  }

  75% {
    opacity: 0.25;
    transform: scale(0.65) rotate(55deg);
  }
}

@-webkit-keyframes starlight-orbit-flow {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(1turn);
  }
}

@keyframes starlight-orbit-flow {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(1turn);
  }
}

@-webkit-keyframes starlight-signal-send {
  0% {
    opacity: 0;
    transform: translateY(0) scale(0.55);
  }

  25% {
    opacity: 0.85;
  }

  100% {
    opacity: 0;
    transform: translateY(-11rpx) scale(1.35);
  }
}

@keyframes starlight-signal-send {
  0% {
    opacity: 0;
    transform: translateY(0) scale(0.55);
  }

  25% {
    opacity: 0.85;
  }

  100% {
    opacity: 0;
    transform: translateY(-11rpx) scale(1.35);
  }
}

.is-paused view,
.state-leave .pose-live view,
.state-live .pose-wait view,
.state-normal .pose-live view {
  animation-play-state: paused !important;
}

.is-lite view {
  animation: none !important;
  transition-duration: 0.12s !important;
}

.is-lite .starlight-beacon,
.is-lite .starlight-orbit,
.is-lite .starlight-signal,
.is-lite .starlight-spark {
  display: none;
}

@media (prefers-reduced-motion: reduce) {
  .starlight-mascot view {
    animation: none !important;
    transition-duration: 0.12s !important;
  }

  .starlight-beacon,
  .starlight-orbit,
  .starlight-signal,
  .starlight-spark {
    display: none;
  }
}
