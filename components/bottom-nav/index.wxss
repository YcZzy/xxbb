.nav-shell {
  background: hsla(0, 0%, 100%, 0.92);
  border: 1rpx solid hsla(0, 0%, 100%, 0.86);
  border-radius: 42rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  box-shadow: 0 18rpx 50rpx rgba(93, 49, 38, 0.16);
  left: 20rpx;
  padding: 8rpx;
  position: fixed;
  right: 20rpx;
  z-index: 50;
}

.nav-panel {
  align-items: center;
  display: flex;
  justify-content: space-around;
  position: relative;
}

.nav-jelly {
  bottom: 0;
  box-sizing: border-box;
  left: 0;
  padding: 0 3rpx;
  pointer-events: none;
  position: absolute;
  top: 0;
  transform: translateX(0);
  width: 25%;
  z-index: 0;
}

.nav-jelly.is-ready {
  transition: transform 0.48s cubic-bezier(0.18, 0.84, 0.24, 1);
  transition:
    transform 0.48s cubic-bezier(0.18, 0.84, 0.24, 1),
    -webkit-transform 0.48s cubic-bezier(0.18, 0.84, 0.24, 1);
}

.nav-jelly.is-media {
  transform: translateX(100%);
}

.nav-jelly.is-history {
  transform: translateX(200%);
}

.nav-jelly.is-help {
  transform: translateX(300%);
}

.nav-jelly-core {
  background: linear-gradient(145deg, #ffeadc, #fffaf2);
  border-radius: 28rpx;
  box-shadow:
    inset 0 0 0 1rpx rgba(217, 58, 47, 0.08),
    0 8rpx 24rpx rgba(190, 42, 38, 0.12);
  inset: 0 3rpx;
  position: absolute;
  transform-origin: center;
  z-index: 0;
}

.nav-jelly-core::after,
.nav-jelly-core::before {
  background: inherit;
  border-radius: 50%;
  content: '';
  height: 50rpx;
  opacity: 0;
  position: absolute;
  top: 19rpx;
  width: 25rpx;
}

.nav-jelly-core::before {
  left: -11rpx;
}

.nav-jelly-core::after {
  right: -11rpx;
}

.nav-jelly.is-moving.is-right .nav-jelly-core {
  animation: nav-jelly-squeeze-right 0.52s cubic-bezier(0.18, 0.84, 0.24, 1) both;
}

.nav-jelly.is-moving.is-left .nav-jelly-core {
  animation: nav-jelly-squeeze-left 0.52s cubic-bezier(0.18, 0.84, 0.24, 1) both;
}

.nav-jelly.is-moving.is-left .nav-jelly-core::after,
.nav-jelly.is-moving.is-right .nav-jelly-core::before {
  animation: nav-jelly-tail 0.52s ease-out both;
}

.nav-item {
  align-items: center;
  border-radius: 28rpx;
  color: #9a8b83;
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-height: 88rpx;
  min-width: 0;
  position: relative;
  transition:
    color 0.18s ease,
    background 0.18s ease,
    box-shadow 0.18s ease,
    -webkit-transform 0.14s ease;
  transition:
    color 0.18s ease,
    background 0.18s ease,
    box-shadow 0.18s ease,
    transform 0.14s ease;
  transition:
    color 0.18s ease,
    background 0.18s ease,
    box-shadow 0.18s ease,
    transform 0.14s ease,
    -webkit-transform 0.14s ease;
  z-index: 1;
}

.nav-item.is-active {
  background: transparent;
  box-shadow: none;
  color: #c92f2c;
}

.nav-item-hover {
  opacity: 1;
  transform: translateY(2rpx) scale(0.96);
}

.nav-icon {
  font-size: 36rpx;
  font-weight: 700;
  height: 38rpx;
  line-height: 42rpx;
  transform-origin: 50% 80%;
}

.nav-item.is-active .nav-icon {
  animation: nav-icon-settle 0.34s cubic-bezier(0.2, 0.9, 0.28, 1.22) both;
}

.nav-icon-history {
  font-size: 46rpx;
  line-height: 38rpx;
}

.nav-icon-archive {
  align-items: center;
  display: flex;
  height: 38rpx;
  justify-content: center;
  line-height: 1;
  width: 46rpx;
}

.nav-archive-symbol {
  height: 28rpx;
  position: relative;
  width: 40rpx;
}

.nav-archive-line {
  background: currentColor;
  border-radius: 999rpx;
  box-shadow: 0 0 7rpx currentColor;
  height: 3rpx;
  opacity: 0.72;
  position: absolute;
  transform-origin: left center;
}

.nav-archive-line.line-one {
  bottom: 8rpx;
  left: 5rpx;
  transform: rotate(-42deg);
  width: 20rpx;
}

.nav-archive-line.line-two {
  left: 21rpx;
  top: 6rpx;
  transform: rotate(29deg);
  width: 16rpx;
}

.nav-archive-dot {
  background: currentColor;
  border: 2rpx solid hsla(0, 0%, 100%, 0.9);
  border-radius: 50%;
  box-shadow: 0 0 0 2rpx currentColor;
  box-sizing: border-box;
  height: 8rpx;
  position: absolute;
  width: 8rpx;
}

.nav-archive-dot.dot-one {
  bottom: 1rpx;
  left: 1rpx;
}

.nav-archive-dot.dot-two {
  left: 17rpx;
  top: 0;
}

.nav-archive-dot.dot-two::after {
  border: 1rpx solid;
  border-radius: 50%;
  content: '';
  inset: -7rpx;
  opacity: 0.18;
  position: absolute;
}

.nav-archive-dot.dot-three {
  right: 0;
  top: 10rpx;
}

.nav-item.is-active .nav-archive-line {
  animation: nav-archive-track 2.8s ease-in-out infinite;
  opacity: 0.96;
}

.nav-item.is-active .nav-archive-dot.dot-two {
  animation: nav-archive-star 2s ease-in-out infinite;
}

.nav-label {
  font-size: 20rpx;
  font-weight: 600;
  margin-top: 6rpx;
}

.nav-item.is-active .nav-label {
  animation: nav-label-settle 0.26s ease-out both;
}

.nav-dot {
  animation: nav-dot-settle 0.32s cubic-bezier(0.2, 0.9, 0.28, 1.3) both;
  background: #d93a2f;
  border-radius: 50%;
  bottom: 2rpx;
  height: 8rpx;
  position: absolute;
  width: 8rpx;
}

.nav-shell.theme-siwuliu-ice {
  background: rgba(248, 253, 255, 0.94);
  border-color: rgba(139, 207, 235, 0.7);
  box-shadow: 0 18rpx 50rpx rgba(62, 116, 155, 0.2);
}

.nav-shell.theme-siwuliu-ice .nav-item {
  color: #7890a1;
}

.nav-shell.theme-siwuliu-ice .nav-item.is-active {
  background: transparent;
  box-shadow: none;
  color: #4c83aa;
}

.nav-shell.theme-siwuliu-ice .nav-jelly-core {
  background: linear-gradient(145deg, #e9f9ff, #f1effa);
  box-shadow:
    inset 0 0 0 1rpx rgba(97, 174, 217, 0.16),
    0 8rpx 24rpx rgba(67, 130, 173, 0.15);
}

.nav-shell.theme-siwuliu-ice .nav-dot {
  background: #69bde1;
  box-shadow: 0 0 12rpx rgba(105, 189, 225, 0.56);
}

.nav-shell.theme-xiaoyu-moon-tide {
  background: rgba(248, 254, 254, 0.95);
  border-color: rgba(91, 199, 205, 0.64);
  box-shadow: 0 18rpx 50rpx rgba(26, 102, 126, 0.18);
}

.nav-shell.theme-xiaoyu-moon-tide .nav-item {
  color: #718f99;
}

.nav-shell.theme-xiaoyu-moon-tide .nav-item.is-active {
  background: transparent;
  box-shadow: none;
  color: #277d91;
}

.nav-shell.theme-xiaoyu-moon-tide .nav-jelly-core {
  background: linear-gradient(145deg, #e5fafb, #fff7e6);
  box-shadow:
    inset 0 0 0 1rpx rgba(52, 175, 188, 0.16),
    0 8rpx 24rpx rgba(27, 118, 141, 0.14);
}

.nav-shell.theme-xiaoyu-moon-tide .nav-dot {
  background: #41c1c7;
  box-shadow: 0 0 12rpx rgba(65, 193, 199, 0.58);
}

@-webkit-keyframes nav-icon-settle {
  0% {
    opacity: 0.56;
    transform: translateY(5rpx) scale(0.86);
  }

  70% {
    opacity: 1;
    transform: translateY(-3rpx) scale(1.08);
  }

  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes nav-icon-settle {
  0% {
    opacity: 0.56;
    transform: translateY(5rpx) scale(0.86);
  }

  70% {
    opacity: 1;
    transform: translateY(-3rpx) scale(1.08);
  }

  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@-webkit-keyframes nav-label-settle {
  from {
    opacity: 0.52;
    transform: translateY(4rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes nav-label-settle {
  from {
    opacity: 0.52;
    transform: translateY(4rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@-webkit-keyframes nav-dot-settle {
  0% {
    opacity: 0;
    transform: scale(0);
  }

  72% {
    opacity: 1;
    transform: scale(1.35);
  }

  100% {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes nav-dot-settle {
  0% {
    opacity: 0;
    transform: scale(0);
  }

  72% {
    opacity: 1;
    transform: scale(1.35);
  }

  100% {
    opacity: 1;
    transform: scale(1);
  }
}

@-webkit-keyframes nav-archive-track {
  0%,
  100% {
    opacity: 0.62;
  }

  50% {
    opacity: 1;
  }
}

@keyframes nav-archive-track {
  0%,
  100% {
    opacity: 0.62;
  }

  50% {
    opacity: 1;
  }
}

@-webkit-keyframes nav-archive-star {
  0%,
  100% {
    transform: scale(0.82);
  }

  50% {
    transform: scale(1.14);
  }
}

@keyframes nav-archive-star {
  0%,
  100% {
    transform: scale(0.82);
  }

  50% {
    transform: scale(1.14);
  }
}

@-webkit-keyframes nav-jelly-squeeze-right {
  0%,
  100% {
    border-radius: 28rpx;
    transform: scale(1) skewX(0);
  }

  26% {
    border-radius: 23rpx 34rpx 34rpx 23rpx;
    transform: scaleX(1.22) scaleY(0.84) skewX(-4deg);
  }

  56% {
    border-radius: 34rpx 24rpx 24rpx 34rpx;
    transform: scaleX(0.9) scaleY(1.1) skewX(2deg);
  }

  78% {
    border-radius: 26rpx 31rpx 31rpx 26rpx;
    transform: scaleX(1.06) scaleY(0.96);
  }
}

@keyframes nav-jelly-squeeze-right {
  0%,
  100% {
    border-radius: 28rpx;
    transform: scale(1) skewX(0);
  }

  26% {
    border-radius: 23rpx 34rpx 34rpx 23rpx;
    transform: scaleX(1.22) scaleY(0.84) skewX(-4deg);
  }

  56% {
    border-radius: 34rpx 24rpx 24rpx 34rpx;
    transform: scaleX(0.9) scaleY(1.1) skewX(2deg);
  }

  78% {
    border-radius: 26rpx 31rpx 31rpx 26rpx;
    transform: scaleX(1.06) scaleY(0.96);
  }
}

@-webkit-keyframes nav-jelly-squeeze-left {
  0%,
  100% {
    border-radius: 28rpx;
    transform: scale(1) skewX(0);
  }

  26% {
    border-radius: 34rpx 23rpx 23rpx 34rpx;
    transform: scaleX(1.22) scaleY(0.84) skewX(4deg);
  }

  56% {
    border-radius: 24rpx 34rpx 34rpx 24rpx;
    transform: scaleX(0.9) scaleY(1.1) skewX(-2deg);
  }

  78% {
    border-radius: 31rpx 26rpx 26rpx 31rpx;
    transform: scaleX(1.06) scaleY(0.96);
  }
}

@keyframes nav-jelly-squeeze-left {
