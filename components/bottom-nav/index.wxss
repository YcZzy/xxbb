}

@-webkit-keyframes nav-jelly-tail {
  0%,
  100% {
    opacity: 0;
    transform: scale(0.35);
  }

  28% {
    opacity: 0.72;
    transform: scaleX(1.24) scaleY(0.8);
  }

  62% {
