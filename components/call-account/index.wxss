.account-panel.theme-ibo-soft-gold,
.account.theme-ibo-soft-gold {
  --accent: #806238;
  --accent-dark: #70552e;
  --soft: #eee6d3;
  --paper: #f7f8f3;
  --line: #dce1d6;
  --ink: #334847;
  --muted: #636d65;
  --secondary: #6c694e;
  --stage: #bcaa83;
  --stage-light: #ded2af;
}

.theme-ibo-soft-gold .account-cover {
  background: linear-gradient(115deg, #b6cdbf, #d2bd95 42%, #e6daba 65%, #b9cfc0);
}

.theme-ibo-soft-gold .account-cover::before {
  background: #e6ddc7;
}

.theme-ibo-soft-gold .account-contour {
  background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='206' height='50'%3E%3Cpath fill='%23f7f8f3' d='M0 46C14 46 24 1 74 1c53 0 56 48 101 48h31v1H0Z'/%3E%3C/svg%3E");
}

.theme-ibo-soft-gold .portrait-prism {
  background: conic-gradient(
    from 20deg,
    #b29c73,
    #efe4c8 22%,
    #aac9b7 44%,
    #fff7df 60%,
    #c5af81 80%,
    #b29c73
  );
}

.theme-ibo-soft-gold .account-portrait-crop {
  background: #f0eee2;
}

.theme-ibo-soft-gold .account-portrait {
  box-shadow: 0 5px 17px #5265491a;
}

.account,
.account-panel {
  --accent: #c94758;
  --accent-dark: #a93244;
  --soft: #fff0f0;
  --paper: #fff7ee;
  --line: #efdfd2;
  --ink: #302d35;
  --muted: #705963;
  --secondary: #896544;
  --stage: #c44857;
  --stage-light: #d76671;
  --ease: cubic-bezier(0.16, 1, 0.3, 1);
  color: var(--ink);
  letter-spacing: 0;
}

.theme-siwuliu-ice {
  --accent: #357f9e;
  --accent-dark: #28657f;
  --soft: #eff8fc;
  --line: #dbeaf0;
  --ink: #294753;
  --muted: #4e6672;
  --stage: #397d96;
  --stage-light: #599eb2;
  --secondary: #386c7a;
}

.theme-xiaoyu-moon-tide {
  --accent: #278694;
  --accent-dark: #246974;
  --soft: #eef9f7;
  --line: #d6e9e5;
  --ink: #294e51;
  --muted: #486569;
  --stage: #378792;
  --stage-light: #62a4a7;
  --secondary: #386f70;
}

.theme-siwuliu-ice,
.theme-xiaoyu-moon-tide {
  --paper: #fffefe;
}

.account {
  background: var(--paper);
  padding: 0;
}

.account button,
.account-panel button {
  background: transparent;
  border: 0;
  border-radius: 0;
  color: inherit;
  font-size: inherit;
  line-height: 1.5;
  margin: 0;
  padding: 0;
  transition:
    background 0.2s,
    -webkit-transform 0.12s ease;
  transition:
    transform 0.12s ease,
    background 0.2s;
  transition:
    transform 0.12s ease,
    background 0.2s,
    -webkit-transform 0.12s ease;
}

.account button::after,
.account-panel button::after {
  border: 0;
}

.account button:active:not([disabled]),
.account-action--pressed,
.account-panel button:active:not([disabled]) {
  transform: translateY(1px) scale(0.975);
}

.account button[disabled],
.account-panel button[disabled] {
  opacity: 0.55;
}

.account-cover {
  background: var(--stage);
  box-sizing: border-box;
  color: #fff;
  height: 80px;
  overflow: hidden;
  position: relative;
}

.account-cover::before {
  background: var(--stage-light);
  content: '';
  height: 230px;
  position: absolute;
  right: -16px;
  top: -84px;
  transform: rotate(30deg);
  width: 118px;
}

.account-cover-sheen {
  animation: cover-silk 8s ease-in-out infinite;
  background: linear-gradient(
    112deg,
    transparent 30%,
    #ffe9d614 43%,
    #fff2de38 49%,
    #ffe9d614 55%,
    transparent 68%
  );
  inset: 0;
  pointer-events: none;
  position: absolute;
  transform: translateX(-110%);
}

.account-contour {
  background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='206' height='50'%3E%3Cpath fill='%23fff7ee' d='M0 46C14 46 24 1 74 1c53 0 56 48 101 48h31v1H0Z'/%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-size: 100% 100%;
  bottom: -1px;
  height: 50px;
  left: 0;
  pointer-events: none;
  position: absolute;
  width: 206px;
}

.theme-siwuliu-ice .account-contour,
.theme-xiaoyu-moon-tide .account-contour {
  background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='206' height='50'%3E%3Cpath fill='%23fffefe' d='M0 46C14 46 24 1 74 1c53 0 56 48 101 48h31v1H0Z'/%3E%3C/svg%3E");
}

.account-contour::after {
  animation: contour-lustre 5.6s ease-in-out infinite;
  background: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='206' height='50'%3E%3Cpath fill='none' stroke='%23ffe6b6' stroke-width='1.6' d='M0 46C14 46 24 1 74 1c53 0 56 48 101 48h31'/%3E%3C/svg%3E")
    50%/100% 100% no-repeat;
  content: '';
  inset: 0;
  opacity: 0.7;
  pointer-events: none;
  position: absolute;
}

.account-identity {
  align-items: flex-start;
  display: flex;
  gap: 17px;
  margin: -43px 24px 18px;
  min-height: 116px;
  position: relative;
}

.account-portrait {
  background: var(--paper);
  border: 4px solid var(--paper);
  border-radius: 50%;
  box-shadow: 0 5px 17px #6c2d4112;
  box-sizing: border-box;
  flex: none;
  height: 100px;
  position: relative;
  width: 100px;
}

.portrait-frame-detail {
  border: 1px solid #d8b787;
  inset: 1px;
  z-index: 2;
}

.portrait-frame-detail,
.portrait-prism {
  border-radius: 50%;
  pointer-events: none;
  position: absolute;
}

.portrait-prism {
  animation: portrait-prism-turn 12s linear infinite;
  background: #e6c497;
  background: conic-gradient(
    from 20deg,
    #e7b789,
    #fff0c5 17%,
    #de8bac 30%,
    #c497c3 39%,
    #8fcac1 51%,
    #fff3d7 66%,
    #e0aa82 79%,
    #f8d6a7 92%,
    #e7b789
  );
  inset: 0;
}

.theme-siwuliu-ice .portrait-prism {
  background: conic-gradient(
    from 20deg,
    #84b9ce,
    #e9faff 18%,
    #b4c2e2 37%,
    #e6b8c9 49%,
    #e7e4be 62%,
    #a1d8d0 80%,
    #84b9ce
  );
}

.theme-xiaoyu-moon-tide .portrait-prism {
  background: conic-gradient(
    from 20deg,
    #7cbaad,
    #f0f8d4 18%,
    #c3aed8 37%,
    #cbdaf5 50%,
    #87c5c2 67%,
    #ecdfb4 83%,
    #7cbaad
  );
}

.account-portrait-crop {
  background: #fff3e9;
  border-radius: 50%;
  inset: 4px;
  overflow: hidden;
  position: absolute;
  z-index: 1;
}

.account-mascot {
  height: 144%;
  left: -22%;
  position: absolute;
  top: -9%;
  width: 144%;
}

.account-name-area {
  flex: 1;
  min-width: 0;
  padding-top: 48px;
}

.account .account-name {
  align-items: center;
  display: flex;
  font-size: 18px;
  font-weight: 600;
  gap: 7px;
  line-height: 1.4;
  min-height: 44px;
  text-align: left;
  width: 100%;
}

.account-name text {
  min-width: 0;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.account-name image {
  background: var(--soft);
  border: 1px solid var(--line);
  border-radius: 50%;
  box-sizing: initial;
  height: 14px;
  padding: 6px;
  width: 14px;
}

.account-name image,
.identity-rank {
  flex: none;
}

.identity-rank .rank-emblem {
  --medal-size: 38px;
}

.rank-placeholder {
  background: var(--line);
  border-radius: 8px;
  height: 44px;
  width: 37px;
}

.account-caption image {
  height: 13px;
  width: 13px;
}

.account .member-progress {
  align-items: center;
  box-sizing: border-box;
  display: flex;
  gap: 8px;
  height: 54px;
  margin: 0;
  max-width: 244px;
  min-height: 44px;
  position: relative;
  text-align: left;
  width: 100%;
}

.progress-track {
  flex: 1;
  height: 20px;
  min-width: 30px;
  overflow: hidden;
  position: relative;
}

.progress-track::after {
  background: var(--line);
}

.progress-track::after,
.progress-track::before {
  content: '';
  height: 2px;
  left: 0;
  position: absolute;
  right: 0;
  top: 9px;
}

.progress-track::before {
  background: linear-gradient(
    90deg,
    transparent 35%,
    var(--stage-light) 48%,
    var(--accent) 52%,
    transparent 65%
  );
  opacity: 0;
  pointer-events: none;
  transform: translateX(-100%);
  z-index: 2;
}

.is-ready .progress-track::before {
  animation: progress-edge 1.8s ease-in-out 0.15s 2;
}

.progress-channel {
  border-radius: 1px;
  height: 2px;
  left: 0;
  right: 0;
  top: 9px;
  z-index: 1;
}

.progress-channel,
.progress-fill {
  overflow: hidden;
  position: absolute;
}

.progress-fill {
  background: linear-gradient(90deg, var(--secondary), var(--accent));
  inset: 0;
  transform-origin: left;
  transition: transform 0.75s var(--ease);
  transition:
    transform 0.75s var(--ease),
    -webkit-transform 0.75s var(--ease);
}

.progress-fill::after {
  background: #fff9;
  bottom: 0;
  content: '';
  position: absolute;
  right: 0;
  top: 0;
  width: 2px;
}

.progress-fill::before {
  background: linear-gradient(110deg, transparent 25%, #ffffff80 50%, transparent 75%);
  content: '';
  inset: 0;
  opacity: 0;
  position: absolute;
  transform: translateX(-100%);
}

.is-ready .progress-fill::before {
  animation: progress-light 1.8s ease-in-out 0.15s 2;
}

.is-upgraded .progress-fill::before {
  animation: progress-light 0.85s var(--ease);
}

.progress-milestones {
  align-items: center;
  display: flex;
  inset: 0;
  justify-content: space-evenly;
  pointer-events: none;
  position: absolute;
  z-index: 3;
}

.progress-milestones > view {
  background: var(--paper);
  border: 1px solid var(--line);
  box-sizing: border-box;
  flex: none;
  height: 5px;
  transform: rotate(45deg);
  transition:
    background 0.25s,
    border-color 0.25s;
  width: 5px;
}

.progress-milestones > .is-lit {
  background: var(--accent);
  border-color: var(--accent);
}

.is-upgraded .progress-milestones > view {
  animation: progress-star 0.55s var(--ease) both;
}

.is-upgraded .progress-milestones > view:nth-child(2) {
  animation-delay: 0.09s;
}

.is-upgraded .progress-milestones > view:nth-child(3) {
  animation-delay: 0.18s;
}

.growth-end,
.growth-target {
  flex: none;
  width: 28px;
}

.growth-target .rank-emblem {
  --medal-size: 28px;
}

.growth-target .rank-art {
  filter: saturate(0.4);
  opacity: 0.68;
}

.growth-target .rank-ribbon {
  background: var(--paper);
  border-color: var(--line);
  color: var(--muted);
  font-size: 9px;
  font-weight: 500;
  left: 0;
  right: 0;
}

.growth-end {
  align-items: center;
  border: 1px solid var(--line);
  border-radius: 50%;
  box-sizing: border-box;
  display: flex;
  height: 28px;
  justify-content: center;
}

.growth-end.is-complete {
  background: #fff9ec;
  border-color: #d8b787;
}

.growth-end image {
  height: 16px;
  width: 16px;
}

.growth-placeholder {
  background: var(--line);
  border-radius: 50%;
  height: 8px;
  width: 8px;
}

.account-wallet {
  align-items: stretch;
  background: var(--paper);
  border-bottom: 1px solid var(--line);
  border-top: 1px solid var(--line);
  gap: 16px;
  margin: 0 24px;
  padding: 14px 0 20px;
}

.account-wallet,
.wallet-content {
  display: flex;
}

.wallet-content {
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.account .wallet-value {
  align-items: center;
  box-sizing: border-box;
  display: flex;
  gap: 4px;
  min-height: 56px;
  text-align: left;
  width: 100%;
}

.wallet-coin,
.wallet-coin-stage {
  flex: none;
  height: 26px;
  width: 26px;
}

.wallet-coin-stage {
  perspective: 120px;
  position: relative;
}

.wallet-coin-face {
  height: 100%;
  position: relative;
  transform-origin: 50% 50%;
  width: 100%;
}

.wallet-coin-face .wallet-coin {
  display: block;
}

.coin-sheen-window {
  border-radius: 50%;
  inset: 10%;
  overflow: hidden;
}

.coin-sheen,
.coin-sheen-window {
  pointer-events: none;
  position: absolute;
}

.coin-sheen {
  animation: coin-metal-scan 4.8s ease-in-out 0.12s infinite;
  background: linear-gradient(
    112deg,
    transparent 42%,
    #dffff338 47%,
    #fff9e9d9 50%,
    #dffff338 53%,
    transparent 58%
  );
  inset: -25% -110%;
  opacity: 0;
  transform: translateX(-60%);
}

.coin-edge-glint {
  animation: coin-edge-turn 4.8s linear infinite;
  border-color: #f6edce #8bd8ce5c transparent transparent;
  border-radius: 50%;
  border-style: solid;
  border-width: 1px;
  box-sizing: border-box;
  inset: 6%;
  opacity: 0.8;
  pointer-events: none;
  position: absolute;
}

.is-credited .wallet-coin-face {
  animation: coin-credit-tilt 0.66s var(--ease) both;
}

.is-credited .coin-sheen {
  animation: coin-credit-scan 0.66s ease-out both;
}

.is-credited .coin-edge-glint {
  border-right-color: #7bdbcf;
  border-top-color: #fff9e9;
  opacity: 1;
}

.account.is-paused .coin-edge-glint,
.account.is-paused .coin-sheen,
.account.is-paused .wallet-coin-face,
.account.performance-lite .coin-edge-glint,
.account.performance-lite .coin-sheen,
.account.performance-lite .wallet-coin-face,
.is-coin-paused .coin-edge-glint,
.is-coin-paused .coin-sheen,
.is-coin-paused .wallet-coin-face {
  animation: none;
}

.account.is-paused .coin-edge-glint,
.account.is-paused .coin-sheen,
.account.performance-lite .coin-edge-glint,
.account.performance-lite .coin-sheen,
.is-coin-paused .coin-edge-glint,
.is-coin-paused .coin-sheen {
  opacity: 0;
}

@-webkit-keyframes coin-metal-scan {
  0% {
    opacity: 0;
    transform: translateX(-60%);
  }

  5% {
    opacity: 0.7;
  }

  23% {
    opacity: 0;
    transform: translateX(60%);
  }

  100% {
    opacity: 0;
    transform: translateX(60%);
  }
}

@keyframes coin-metal-scan {
  0% {
    opacity: 0;
    transform: translateX(-60%);
  }

  5% {
    opacity: 0.7;
  }

  23% {
    opacity: 0;
    transform: translateX(60%);
  }

  100% {
    opacity: 0;
    transform: translateX(60%);
  }
}

@-webkit-keyframes coin-edge-turn {
  to {
    transform: rotate(1turn);
  }
}

@keyframes coin-edge-turn {
  to {
    transform: rotate(1turn);
  }
}

@-webkit-keyframes coin-credit-scan {
  0% {
    opacity: 0;
    transform: translateX(-60%);
  }

  18%,
  58% {
    opacity: 1;
  }

  100% {
    opacity: 0;
    transform: translateX(60%);
  }
}

@keyframes coin-credit-scan {
  0% {
    opacity: 0;
    transform: translateX(-60%);
  }

  18%,
  58% {
    opacity: 1;
  }

  100% {
    opacity: 0;
    transform: translateX(60%);
  }
}

@-webkit-keyframes coin-credit-tilt {
  0%,
  100% {
    transform: rotateY(0) scale(1);
  }

  32% {
    transform: rotateY(-24deg) rotateZ(-7deg) scale(1.08);
  }

  68% {
    transform: rotateY(10deg) rotateZ(2deg) scale(1.03);
  }
}

@keyframes coin-credit-tilt {
  0%,
  100% {
    transform: rotateY(0) scale(1);
  }

  32% {
    transform: rotateY(-24deg) rotateZ(-7deg) scale(1.08);
  }

  68% {
    transform: rotateY(10deg) rotateZ(2deg) scale(1.03);
  }
}

@media (prefers-reduced-motion: reduce) {
  .wallet-coin-stage .coin-edge-glint,
  .wallet-coin-stage .coin-sheen,
  .wallet-coin-stage .wallet-coin-face {
    animation: none;
  }

  .wallet-coin-stage .coin-edge-glint,
  .wallet-coin-stage .coin-sheen {
    opacity: 0;
  }
}

.wallet-refresh {
  flex: none;
  height: 14px;
  width: 14px;
}

.account .wallet-refresh-control,
.account .wallet-refresh-control[disabled] {
  align-items: center;
  background: transparent !important;
  border-radius: 50%;
  box-shadow: none;
  display: flex;
  flex: none;
  height: 44px;
  justify-content: center;
  min-height: 44px;
  opacity: 1;
  width: 44px;
}

.wallet-refresh-control[disabled] .wallet-refresh {
  opacity: 0.55;
}

.account .wallet-refresh--pressed,
.account .wallet-refresh-control:active:not([disabled]) {
  background: var(--soft) !important;
  transform: scale(0.94);
}

.account .wallet-refresh-control:focus-visible {
  outline: 2px solid var(--accent-dark);
  outline-offset: -5px;
}

.wallet-number {
  align-items: center;
  color: var(--ink);
  display: flex;
  font-size: 34px;
  font-variant-numeric: tabular-nums;
  font-weight: 600;
  line-height: 1.15;
  max-width: 100%;
  min-height: 44px;
}

.balance-digit,
.wallet-number {
  flex: none;
  overflow: hidden;
}

.balance-digit {
  height: 1.16em;
  line-height: 1.16em;
  position: relative;
  width: 0.61em;
}

.balance-digit.is-comma {
  width: 0.25em;
}

.balance-digit text {
  inset: 0;
  position: absolute;
}

.balance-digit .digit-old {
  opacity: 0;
}

.is-rolling .is-changing .digit-old {
  animation: balance-out 0.62s var(--ease) both;
}

.is-rolling .is-changing .digit-new {
  animation: balance-in 0.62s var(--ease) both;
}

.wallet-note {
  color: var(--muted);
  display: block;
  font-size: 12px;
  margin-top: 4px;
}

.wallet-actions {
  align-items: flex-end;
  display: flex;
  flex: none;
  flex-direction: column;
  justify-content: space-between;
}

.account .wallet-records {
  align-items: center;
  color: var(--accent-dark);
  display: flex;
  font-size: 13px;
  font-weight: 600;
  gap: 4px;
  justify-content: flex-end;
  margin-top: -4px;
  min-height: 44px;
  min-width: 52px;
}

.wallet-records image {
  height: 15px;
  width: 15px;
}

.account .wallet-recharge {
  align-items: center;
  background: linear-gradient(135deg, #ffffff10, transparent 65%), var(--accent-dark);
  border-radius: 8px;
  box-shadow:
    inset 0 1px 0 #ffffff45,
    0 3px 9px #302d3510;
  box-sizing: border-box;
  color: #fff;
  display: flex;
  font-size: 14px;
  font-weight: 600;
  gap: 9px;
  height: 44px;
  justify-content: center;
  min-width: 102px;
  padding: 0 16px;
}

.wallet-recharge image {
  height: 15px;
  width: 15px;
}

.account .wallet-recharge[disabled] {
  background: #e9e5e8;
  box-shadow: none;
  color: #797079;
  opacity: 1;
}

.account-error {
  align-items: center;
  color: #9d3b4e;
  display: flex;
  font-size: 12px;
  gap: 12px;
  justify-content: space-between;
  padding: 10px 24px;
}

.account-error button {
  color: var(--accent-dark);
  flex: none;
  min-height: 44px;
  padding: 0 10px;
}

.rank-emblem {
  --medal-size: 38px;
  --rank-color: #64462f;
  --rank-rim: #bd9159;
  flex: none;
  height: calc(var(--medal-size) + 14px);
}

.rank-core,
.rank-emblem {
  position: relative;
  width: var(--medal-size);
}

.rank-core {
  box-sizing: border-box;
  height: var(--medal-size);
  overflow: hidden;
  transform-origin: 50% 60%;
  transition: transform 0.18s var(--ease);
  transition:
    transform 0.18s var(--ease),
    -webkit-transform 0.18s var(--ease);
}

.account-caption .rank-core .rank-art,
.rank-core .rank-art {
  display: block;
  height: 100%;
  width: 100%;
}

.rank-ribbon {
  align-items: center;
  background: var(--rank-color);
  border: 1px solid var(--rank-rim);
  border-radius: 5px;
  bottom: 0;
  box-sizing: border-box;
  color: #fffdf7;
  display: flex;
  font-size: 10px;
  font-variant-numeric: tabular-nums;
  font-weight: 700;
  height: 15px;
  justify-content: center;
  left: 1px;
  line-height: 13px;
  margin: 0 auto;
  max-width: 40px;
  position: absolute;
  right: 1px;
}

.rank-1 {
  --rank-color: #205447;
  --rank-rim: #82aa97;
}

.rank-2 {
  --rank-color: #773d52;
  --rank-rim: #c48e9f;
}

.rank-3 {
  --rank-color: #294a76;
  --rank-rim: #819dbf;
}

.rank-4 {
  --rank-color: #69501d;
  --rank-rim: #bfa068;
}

.rank-5 {
  --rank-color: #274a4e;
  --rank-rim: #84a5a7;
}

.rank-6 {
  --rank-color: #534068;
  --rank-rim: #a998b9;
}

.rank-7 {
  --rank-color: #2b5971;
  --rank-rim: #99b6c6;
}

.rank-8 {
  --rank-color: #743847;
  --rank-rim: #c8988a;
}

.rank-9 {
  --rank-color: #343e6c;
  --rank-rim: #a3a6c5;
}

.rank-10 {
  --rank-color: #745437;
  --rank-rim: #cab18b;
}

.rank-11 {
  --rank-color: #294943;
  --rank-rim: #a5b49c;
}

.rank-12 {
  --rank-color: #3e463f;
  --rank-rim: #bca878;
}

.rank-core::after {
  background: linear-gradient(
    112deg,
    transparent 30%,
    #ffffff18 40%,
    #ffffffc4 50%,
    #ffffff18 60%,
    transparent 70%
  );
  border-radius: 50%;
  content: '';
  inset: 18% 25%;
  opacity: 0;
  pointer-events: none;
  position: absolute;
  transform: translateX(-65%);
}

.is-ready .identity-rank .rank-core::after {
  animation: rank-light 1.1s 0.25s var(--ease) both;
}

.account-panel .level-summary-emblem .rank-core::after {
  animation: rank-light 1.1s 0.15s var(--ease) both;
}

.account-panel .is-current .rank-core::after {
  animation: rank-light 1.1s 0.38s var(--ease) both;
}

.account .member-progress:active .identity-rank .rank-core {
  transform: rotate(-5deg) scale(0.96);
}

.is-upgraded .rank-core {
  animation: rank-turn 0.75s var(--ease);
}

.identity-rank.is-upgraded .rank-core::after {
  animation: rank-upgrade-light 0.85s ease-out 0.23s both;
}

.account-portrait.is-upgraded {
  animation: portrait-ack 0.65s var(--ease);
}

.is-spinning {
  animation: wallet-spin 1s linear infinite;
}

.account-overlay {
  align-items: center;
  background: #30232e61;
  box-sizing: border-box;
  display: flex;
  inset: 0;
  justify-content: center;
  padding: 16px;
  position: fixed;
  z-index: 2200;
}

.account-panel {
  animation: account-panel-in 0.28s var(--ease);
  background: var(--paper);
  border-radius: 8px;
  box-shadow: 0 20px 50px #30232e29;
  box-sizing: border-box;
  max-height: 86vh;
  max-width: 390px;
  overflow-y: auto;
  padding: 18px 22px 24px;
  width: 100%;
}

.account-panel-head {
  align-items: center;
  display: flex;
  font-size: 18px;
  font-weight: 700;
  gap: 12px;
  justify-content: space-between;
  margin-bottom: 8px;
}

.account-panel.is-levels {
  overflow: hidden;
  padding-bottom: 18px;
}

.levels-scroll {
  display: block;
  height: calc(86vh - 110px);
  max-height: 620px;
  overflow-y: auto;
  overscroll-behavior: contain;
}

.account-panel .account-icon {
  align-items: center;
  display: flex;
  flex: none;
  height: 44px;
  justify-content: center;
  margin-right: -10px;
  width: 44px;
}

.account-icon image {
  height: 20px;
  width: 20px;
}

.panel-intro,
.panel-note {
  color: var(--muted);
  display: block;
  font-size: 12px;
  line-height: 1.7;
}

.nickname-input {
  background: var(--soft);
  border: 1px solid var(--line);
  border-radius: 8px;
  box-sizing: border-box;
  color: var(--ink);
  display: block;
  font-size: 15px;
  height: 46px;
  margin-top: 18px;
  padding: 10px 12px;
  width: 100%;
}

.nickname-meta {
  color: var(--muted);
  display: flex;
  font-size: 11px;
  gap: 12px;
  justify-content: space-between;
  margin: 10px 0 18px;
}

.account-panel .panel-save {
  align-items: center;
  background: var(--accent);
  border-radius: 8px;
  color: #fff;
  display: flex;
  font-size: 14px;
  justify-content: center;
  margin-top: 18px;
  min-height: 46px;
  width: 100%;
}

.account-panel .panel-save[disabled] {
  background: #e5e9e9;
  color: #697575;
  opacity: 1;
}

.level-summary {
  align-items: center;
  border-bottom: 1px solid var(--line);
  color: var(--muted);
  display: flex;
  font-size: 12px;
  gap: 14px;
  margin: 0 0 16px;
  padding: 8px 0 18px;
}

.level-summary-emblem .rank-emblem {
  --medal-size: 64px;
}

.level-summary-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 7px;
  min-width: 0;
}

.level-summary-name {
  color: var(--ink);
  font-size: 20px;
  font-weight: 700;
}

.level-next {
  font-size: 11px;
  line-height: 1.6;
}

.level-summary-mark {
  color: var(--accent-dark);
  font-size: 14px;
  font-weight: 600;
}

.levels-grid {
  display: grid;
  gap: 8px;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.level-preview-hint {
  color: var(--muted);
  display: block;
  font-size: 12px;
  margin-bottom: 12px;
}

.account-panel .level-preview {
  align-items: center;
  border-radius: 12px;
  display: flex;
  justify-content: center;
  min-height: 74px;
  width: 64px;
}

.account-panel .level-preview:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.level-item {
  align-items: center;
  border: 1px solid var(--line);
  border-radius: 14px;
  color: var(--muted);
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 0;
  padding: 14px 3px 12px;
}

.level-emblem .rank-emblem {
  --medal-size: 56px;
}

.level-emblem {
  filter: saturate(0.4);
  opacity: 0.76;
}

.is-earned .level-emblem,
.is-unreleased .level-emblem {
  filter: none;
  opacity: 1;
}

.is-preview-a .rank-core {
  animation: rank-turn 0.75s var(--ease);
}

.is-preview-b .rank-core {
  animation: rank-preview-turn 0.75s var(--ease);
}

.account-panel .is-preview-a .rank-core::after {
  animation: rank-light 0.85s ease-out both;
}

.account-panel .is-preview-b .rank-core::after {
  animation: rank-upgrade-light 0.85s ease-out both;
}

.level-item.is-current {
  background: var(--soft);
  border-color: var(--accent);
}

.level-title {
  color: var(--ink);
  font-size: 13px;
}

.level-requires,
.level-status {
  font-size: 11px;
  line-height: 1.5;
  min-height: 16px;
}

.is-current .level-status {
  color: var(--accent-dark);
  font-weight: 600;
}

.level-rules {
  color: var(--muted);
  display: flex;
  flex-direction: column;
  gap: 9px;
  margin-top: 18px;
}

.level-rules,
.panel-error {
  font-size: 12px;
  line-height: 1.7;
}

.panel-error {
  color: #9d3b4e;
  display: block;
  margin-top: 14px;
}

@-webkit-keyframes balance-out {
  from {
    opacity: 1;
    transform: translateY(0);
  }

  to {
    opacity: 0;
    transform: translateY(-115%);
  }
}

@keyframes balance-out {
  from {
    opacity: 1;
    transform: translateY(0);
  }

  to {
    opacity: 0;
    transform: translateY(-115%);
  }
}

@-webkit-keyframes balance-in {
  from {
    transform: translateY(115%);
  }

  to {
    transform: translateY(0);
  }
}

@keyframes balance-in {
  from {
    transform: translateY(115%);
  }

  to {
    transform: translateY(0);
  }
}

@-webkit-keyframes rank-turn {
  0% {
    transform: rotateY(-75deg) scale(0.8);
  }

  70% {
    transform: rotateY(8deg) scale(1.08);
  }

  100% {
    transform: rotateY(0) scale(1);
  }
}

@keyframes rank-turn {
  0% {
    transform: rotateY(-75deg) scale(0.8);
  }

  70% {
    transform: rotateY(8deg) scale(1.08);
  }

  100% {
    transform: rotateY(0) scale(1);
  }
}

@-webkit-keyframes rank-preview-turn {
  0% {
    transform: rotateY(-75deg) scale(0.8);
  }

  70% {
    transform: rotateY(8deg) scale(1.08);
  }

  100% {
    transform: rotateY(0) scale(1);
  }
}

@keyframes rank-preview-turn {
  0% {
    transform: rotateY(-75deg) scale(0.8);
  }

  70% {
    transform: rotateY(8deg) scale(1.08);
  }

  100% {
    transform: rotateY(0) scale(1);
  }
}

@-webkit-keyframes rank-light {
  0% {
    opacity: 0;
    transform: translateX(-65%);
  }

  20%,
  60% {
    opacity: 0.8;
  }

  100% {
    opacity: 0;
    transform: translateX(65%);
  }
}

@keyframes rank-light {
  0% {
    opacity: 0;
    transform: translateX(-65%);
  }

  20%,
  60% {
    opacity: 0.8;
  }

  100% {
    opacity: 0;
    transform: translateX(65%);
  }
}

@-webkit-keyframes rank-upgrade-light {
  0% {
    opacity: 0;
    transform: translateX(-65%);
  }

  20%,
  60% {
    opacity: 1;
  }

  100% {
    opacity: 0;
    transform: translateX(65%);
  }
}

@keyframes rank-upgrade-light {
  0% {
    opacity: 0;
    transform: translateX(-65%);
  }

  20%,
  60% {
    opacity: 1;
  }

  100% {
    opacity: 0;
    transform: translateX(65%);
  }
}

@-webkit-keyframes portrait-ack {
  40% {
    transform: translateY(-3px) scale(1.035);
  }
}

@keyframes portrait-ack {
  40% {
    transform: translateY(-3px) scale(1.035);
  }
}

@-webkit-keyframes progress-light {
  0% {
    opacity: 0;
    transform: translateX(-100%);
  }

  25% {
    opacity: 1;
  }

  100% {
    opacity: 0;
    transform: translateX(100%);
  }
}

@keyframes progress-light {
  0% {
    opacity: 0;
    transform: translateX(-100%);
  }

  25% {
    opacity: 1;
  }

  100% {
    opacity: 0;
    transform: translateX(100%);
  }
}

@-webkit-keyframes progress-edge {
  0%,
  100% {
    opacity: 0;
  }

  12%,
  78% {
    opacity: 0.9;
  }

  0% {
    transform: translateX(-85%);
  }

  100% {
    transform: translateX(85%);
  }
}

@keyframes progress-edge {
  0%,
  100% {
    opacity: 0;
  }

  12%,
  78% {
    opacity: 0.9;
  }

  0% {
    transform: translateX(-85%);
  }

  100% {
    transform: translateX(85%);
  }
}

@-webkit-keyframes progress-star {
  0%,
  100% {
    transform: rotate(45deg) scale(1);
  }

  45% {
    transform: rotate(45deg) scale(1.6);
  }
}

@keyframes progress-star {
  0%,
  100% {
    transform: rotate(45deg) scale(1);
  }

  45% {
    transform: rotate(45deg) scale(1.6);
  }
}

@-webkit-keyframes wallet-spin {
  to {
    transform: rotate(1turn);
  }
}

@keyframes wallet-spin {
  to {
    transform: rotate(1turn);
  }
}

@-webkit-keyframes portrait-prism-turn {
  to {
    transform: rotate(1turn);
  }
}

@keyframes portrait-prism-turn {
  to {
    transform: rotate(1turn);
  }
}

@-webkit-keyframes contour-lustre {
  0%,
  100% {
    opacity: 0.4;
  }

  48% {
    opacity: 1;
  }

  72% {
    opacity: 0.65;
  }
