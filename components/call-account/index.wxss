  0%,
  18% {
    opacity: 0;
    transform: translateX(-110%);
  }

  26% {
    opacity: 1;
  }

  66% {
    opacity: 0;
    transform: translateX(110%);
  }

  100% {
    opacity: 0;
    transform: translateX(110%);
  }
}

@keyframes cover-silk {
  0%,
  18% {
    opacity: 0;
    transform: translateX(-110%);
  }

  26% {
    opacity: 1;
  }

  66% {
    opacity: 0;
    transform: translateX(110%);
  }

  100% {
    opacity: 0;
    transform: translateX(110%);
  }
}

@-webkit-keyframes account-panel-in {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.98);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes account-panel-in {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.98);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.is-paused .progress-fill,
.performance-lite .progress-fill {
  transition: none;
}

.is-paused .account-contour::after,
.is-paused .account-cover-sheen,
.is-paused .portrait-prism {
  animation-play-state: paused;
}

.performance-lite .account-contour::after,
.performance-lite .account-cover-sheen,
.performance-lite .portrait-prism {
  animation: none;
}

.performance-lite .account-cover-sheen {
  opacity: 0;
}

@media (prefers-reduced-motion: reduce) {
  .account-contour::after,
  .account-cover-sheen,
  .portrait-prism {
    animation: none;
  }

  .account-cover-sheen {
    opacity: 0;
  }
}

.is-paused .progress-fill::before,
.is-paused .progress-track::before,
.performance-lite .progress-fill::before,
.performance-lite .progress-track::before {
  animation: none;
}

.is-paused .progress-milestones > view,
.performance-lite .progress-milestones > view {
  animation: none;
  transition: none;
}

.account.is-paused .digit-new,
.account.is-paused .digit-old,
.account.performance-lite .digit-new,
.account.performance-lite .digit-old,
.is-paused .account-portrait,
.is-paused .is-spinning,
.is-paused .rank-core,
.is-paused .rank-core::after,
.performance-lite .account-portrait,
.performance-lite .is-spinning,
.performance-lite .rank-core,
.performance-lite .rank-core::after,
.performance-lite.account-panel {
  animation: none;
}

@media (prefers-reduced-motion: reduce) {
  .account button,
  .account-panel button,
  .progress-fill,
  .progress-milestones > view {
    transition: none;
  }

  .account-panel,
  .account-portrait,
  .is-ready .progress-fill::before,
  .is-ready .progress-track::before,
  .is-rolling .is-changing .digit-new,
  .is-rolling .is-changing .digit-old,
  .is-spinning,
  .is-upgraded .progress-fill::before,
  .is-upgraded .progress-milestones > view,
  .rank-core,
  .rank-core::after {
    animation: none;
  }
}

.account-panel.is-paused .rank-core::after,
.account-panel.performance-lite .rank-core::after,
.account.is-paused .rank-core::after,
.account.performance-lite .rank-core::after {
  animation: none;
}

.is-paused .rank-core,
.performance-lite .rank-core {
  transition: none;
}

@media (prefers-reduced-motion: reduce) {
  .account .rank-core,
  .account-panel .rank-core {
    transition: none;
  }

  .account .identity-rank .rank-core::after,
  .account-panel .is-preview-a .rank-core::after,
  .account-panel .is-preview-b .rank-core::after,
  .account-panel .rank-core::after,
  .is-preview-a .rank-core,
  .is-preview-b .rank-core,
  .is-upgraded .rank-core {
    animation: none;
  }
}

@media (max-width: 350px) {
  .account-contour {
    left: -11px;
  }

  .account-identity {
    gap: 12px;
    margin-left: 20px;
    margin-right: 20px;
  }

  .account-portrait {
    height: 86px;
    width: 86px;
  }

  .account .account-name {
    gap: 5px;
  }

  .account-wallet {
    gap: 10px;
    margin-left: 20px;
    margin-right: 20px;
  }

  .account .wallet-recharge {
    min-width: 80px;
    padding: 0 10px;
  }
}
